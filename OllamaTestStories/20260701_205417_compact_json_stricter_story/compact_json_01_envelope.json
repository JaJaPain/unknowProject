  "response": "{\"campaign_title\": \"The Hollowed Veins\",\n  \"campaign_subtitle\": \"A Scarcity of Sovereignty\",\n  \"campaign_logline\": \"Navigate the collapsing economic infrastructure of a dying trade route.\",\n  \"campaign_pitch\": \"Trade routes are failing due to resource depletion. You must navigate three warring factions and find new ways to survive.\",\n  \"campaign_story_summary\": \"The central hub is running dry on essential minerals. Zenith seeks to monopolize the remaining supply. Aurelia demands equitable distribution among all colonies. Vanguard insists on aggressive expansion into contested zones. You are a pilot navigating these shifting loyalties. The local economy is collapsing under their pressure.\",\n  \"tone\": \"Dry, cynical frontier humor.\",\n  \"opening\": {\n    \"status_quo\": \"Trade routes are failing due to resource depletion.\",\n    \"visible_crisis\": \"The cost of basic supplies rises daily.\",\n    \"hidden_crisis\": \"A massive infrastructure failure in the main gate network is causing supply chain collapses.\",\n    \"why_now\": \"The local hub is running out of fuel for the jump gates.\",\n    \"player_role\": \"An independent pilot seeking to pay off ship debts.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why are the gate networks failing?\",\n    \"false_answer\": \"It is a simple mechanical failure in the aging hardware.\",\n    \"true_answer_hint\": \"The gates are being intentionally throttled by an unknown entity to force local consolidation.\",\n    \"long_term_reveal_direction\": \"The scope of the infrastructure sabotage is much larger than this sector.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker and contract handler.\",\n    \"secret_angle\": \"She knows exactly which gates are being throttled and why.\",\n    \"address_rule\": \"Refer to her as a broker or fixer.\",\n    \"never_reveal_rule\": \"Never reveal her knowledge of the gate infrastructure.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"They want to hoard resources for elite members only.\",\n    \"aurelia_problem\": \"They are struggling to maintain a fair distribution system.\",\n    \"vanguard_problem\": \"They believe expansion is the only way to survive.\",\n    \"conflict_triangle\": \"Zenith and Aurelia fight over trade rights, while Vanguard pushes for new territory.\",\n    \"neutral_space_pressure\": \"Independent pilots are being squeezed out of the market.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Scarcity Hunt\",\n    \"goal\": \"Secure a stable supply chain for local trade.\",\n    \"opening_incident\": \"A shipment of minerals is intercepted by a rogue Reaver ship.\",\n    \"midpoint_turn\": \"You discover that the Aurelia faction is secretly cooperating with Vanguard.\",\n    \"finale\": \"You successfully secure a delivery route and earn your first major contract.\",\n    \"player_takeaway\": \"The local economy is fractured and desperate.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"Scavenge the Breach\",\n    \"reason\": \"A shipment of minerals was lost during a pirate raid.\",\n    \"enemy_identity\": \"Reaver scout ship.\",\n    \"enemy_knows\": \"The Reaver is patrolling for stolen goods.\",\n    \"aftershock\": \"You recover the cargo and find evidence of local smuggling.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"The Ghost Gate\",\n    \"signal\": \"A faint, rhythmic pulse from a dead gate.\",\n    \"first__appearance\": \"Found near a derelict trade station.\",\n    \"escalation\": \"The pulse becomes more frequent and intense as you travel.\",\n    \"payoff_hint\": \"It points toward the nearest malfunctioning gate.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Shadow Broker's Toll\",\n    \"trail_id\": \"rumor_trail.shadow_broker_toll\",\n    \"hint_theme\": \"Hidden routes and smuggler paths.\",\n    \"clue_templates\": [\n      \"A courier says the shadow route is safer than the main gate.\",\n      \"A merchant speaks of a hidden shortcut through the sector.\"\n    ],\n    \"discovery_type\": \"hidden_route\",\n    \"rarity\": \"uncommon\",\n    \"payoff\": \"Unlocks a secret passage to a nearby system.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The next gate leads to a different, more prosperous-looking sector.\",\n    \"new_system_reveal_rule\": \"Do not reveal future frontier factions during this campaign.\",\n    \"future_faction_tease\": \"Rumors of other factions and their interests are heard in the rest of the galaxy.\",\n    \"future_ore_or_upgrade_tease\": \"A new type of rare ore is mentioned in a rumor.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regeneration_trigger.gate_pass\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the main arc is finished, a new gate pass will be revealed.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Use dry, cynical frontier humor.\",\n    \"fallback_rule\": \"If a story beat is not met, use a broker-provided contract.\",\n    \"banned_repeats\": [\n      \"chosen one\",\n      \"destiny\",\n      \"prophecy\",\n      \"mysterious pulse\",\n      \"ancient signal\"\n    ]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What is the purpose of the main gate network?\",\n    \"Why are some gates being throttled?\",\n    \"How do the factions fight over resources?\",\n    \"Who is behind the forcing of local consolidation?\",\n    \"Why is the system in a state of scarcity? \"\n  ]\n}",
