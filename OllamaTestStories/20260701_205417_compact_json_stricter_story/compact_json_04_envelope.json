  "response": "{\"campaign_title\": \"Dust of the Reach\",\n  \"campaign_subtitle\": \"The Scarcity Crisis\",\n  \"campaign_logline\": \"A desperate pilot navigates a shrinking economy in a dying sector.\",\n  \"campaign_pitch\": \"Trade routes are collapsing under heavy taxes. You must navigate the friction between three competing powers.\",\n  \"campaign_story_summary\": \"Resource scarcity is strangling the frontier. Zenith demands total control of trade hubs. Aurelia seeks independence through privateer tactics. Vanguard maintains a strict military blockade. You find profit in the cracks of their conflict.\",\n  \"tone\": \"Dry, gritty frontier humor.\",\n  \"opening\": {\n    \"status_quo\": \"Trade routes are collapsing under heavy taxes.\",\n    \"visible_crisis\": \"The local economy is failing due to high tariffs and supply shortages.\",\n    \"hidden_crisis\": \"A massive logistics network failure is causing the scarcity.\",\n    \"why_now\": \"Fuel prices have spiked, making independent travel dangerous.\",\n    \"player_role\": \"An independent pilot seeking a steady paycheck.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why are the trade routes failing?\",\n    \"false_answer\": \"The routes are being sabotaged by pirates.\",\n    \"true_answer_hint\": \"Automated logistics systems have malfunctioned and locked out all but a few keys.\",\n    \"long_term_reveal_direction\": \"The system is slowly shutting down the entire sector's infrastructure.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker, fixer, and contract handler.\",\n    \"secret_angle\": \"She knows exactly where the logistics keys are hidden.\",\n    \"address_rule\": \"Refer to her as a broker or a contact.\",\n    \"never__reveal_rule\": \"Never reveal her role as a gate scientist or prophet.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith wants to monopolize the trade hubs to stabilize their economy.\",\n    \"aurelia_problem\": \"Aurelia is funding privateers to break the monopoly of others.\",\n    \"vanguard_problem\": \"Vanguard enforces a strict blockade to prevent smuggling and chaos.\",\n    \"conflict_triangle\": \"The three factions are locked in a resource war over trade routes.\",\n    \"neutral_space_pressure\": \"Independent pilots are being squeezed out by increasing surveillance.\"\n  },\n  \"act_1\": {\n    \"name\": \"Broken Links\",\n    \"goal\": \"Secure enough supplies to establish a stable route.\",\n    \"opening_incident\": \"A shipment of high-grade fuel is intercepted by an Aurelia pirate ship.\",\n    \"midpoint_turn\": \"You discover that the supply shortage is not just caused by pirates, but by a system failure.\",\n    \"finale\": \"You successfully deliver a cargo haul to a secure zone.\",\n    \"player__takeaway\": \"The trade routes are becoming increasingly difficult and dangerous.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"The Rogue Hauler\",\n    \"reason\": \"A local smuggler's ship was damaged by an Aurelia pirate.\",\n    \"enemy_identity\": \"Reaver-class hauler.\",\n    \"enemy_knows\": \"The enemy is unaware of the larger conflict.\",\n    \"aftershock_1\": \"You find a log showing a failed delivery.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"Ghost Signal\",\n    \"signal\": \"A repeating pulse from an abandoned mining site.\",\n    \"first_appearance\": \"Found in the logs of the rogue hauler.\",\n    \"escalation\": \"The signal becomes more frequent as you move towards trade hubs.\",\n    \"payoff_hint\": \"The signal is linked to the old logistics network.\"\n  },\n  \"rumor__trail\": {\n    \"name\": \"The Ghost Route\",\n    \"trail_id\": \"rumor_trail.ghost_route\",\n    \"hint_theme\": \"Abandoned routes and hidden paths.\",\n    \"clue_templates\": [\"A smuggler's map of a dead route.\", \"A log about an automated gate.\"],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"uncommon\",\n    \"payoff\": \"Unlock a secret passage to the next system.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The gates are showing signs of instability.\",\n    \"new_system_reveal_rule\": \"New systems only appear when the player reaches a gate.\",\n    \"future_faction_tease\": \"Rumors of an outside force seeking to lure them in.\",\n    \"future_ore_or_upgrade_tease\": \"Rare minerals are found in unstable zones.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regeneration_trigger.logistics_failure\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the logistics failure is revealed, add new story elements.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Use dry, gritty frontier humor.\",\n    \"fallback_rule\": \"If a quest log is not clear, use Kaelen's guidance.\",\n    \"banned_repeats\": [\"chosen one\", \"destiny\", \"prophecy\", \"ghost signal\"]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What are the consequences of the logistics failure?\",\n    \"Why is Kaelen's role in the system truly significant?\",\n    \"How does Vanguard's blockade policy change if they lose a single hub?\",\n    \"Who are the turn-key holders for the old logistics network?\",\n    \"Where is the hidden infrastructure of the sector?\"]\n}",
