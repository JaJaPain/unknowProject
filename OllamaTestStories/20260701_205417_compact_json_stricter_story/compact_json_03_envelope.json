  "response": "{\"campaign_title\": \"Dust of the Core\", \"campaign_subtitle\": \"The Scarcity Crisis\", \"campaign_logline\": \"A desperate pilot navigates a crumbling economic web between three warring factions.\", \"campaign_pitch\": \"Trade routes are collapsing under heavy tariffs. You must navigate the greed of Zenith, the pride of Aurelia, and the grit of Vanguard.\", \"campaign_story_summary\": \"The core systems are starving for resources. Zenith demands more, while Aurelia seeks dominance. Vanguard fights to keep their people alive. You find profit in the chaos between them.\", \"tone\": \"Dry, cynical frontier humor.\", \"opening\": {\n    \"status_quo\": \"Trade routes are collapsing under heavy tariffs.\",\n    \"visible_crisis\": \"Resource scarcity is causing local price spikes.\",\n    \"hidden_crisis\": \"A massive logistics chain collapse has crippled the inner core.\",\n    \"why_now\": \"The current supply cycle just ended, leaving ports empty.\",\n    \"player_role\": \"You are a broke independent pilot.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why is the trade network failing?\",\n    \"false_answer\": \"Corrupt officials are hoarding supplies for themselves.\",\n    \"true_answer_hint\": \"The core routes have been physically blocked by orbital debris.\",\n    \"long_term_reveal_direction\": \"The blockage was caused by a deliberate sabotage.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker and contract handler.\",\n    \"secret_angle\": \"She monitors the logistics network's integrity.\",\n    \"address_rule\": \"Refer to her as a fixer or broker.\",\n    \"never_reveal_rule\": \"Never mention her knowledge of orbital mechanics.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"They are desperate for luxury components.\",\n    \"aurelia_problem\": \"They want to secure the mining rights.\",\n    \"vanguard_problem\": \"They need basic survival supplies.\",\n    \"conflict_triangle\": \"All three factions fight over the same shrinking pool of resources.\",\n    \"neutral_space_pressure\": \"Pirates are moving into the gaps left by trade ships.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Scarcity Gap\",\n    \"goal\": \"Secure enough supply lines to earn a living.\",\n    \"opening_incident\": \"A high-value shipment is intercepted and lost.\",\n    \"midpoint_turn\": \"You find the cargo in a pirate hideout.\",\n    \"finale\": \"You deliver the haul to a neutral station.\",\n    \"player_takeaway\": \"Survival depends on finding hidden routes.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"The Outbound Haul\",\n    \"reason\": \"A transport ship was intercepted by a pirate.\",\n    \"enemy_identity\": \"A Reaver-class scavenger ship.\",\n    \"enemy_knows\": \"It is hunting for abandoned cargo.\",\n    \"aftershock\": \"You find the wreckage of the original shipment.\"\n  },\n  \"recurring_lue\": {\n    \"name\": \"The Ghost Route\",\n    \"signal\": \"A faint, rhythmic pulse in navigation data.\",\n    \"first_appearance\": \"It appears on your HUD during a jump.\",\n    \"escalation\": \"The signal repeats near high-value trade routes.\",\n    \"payoff_hint\": \"The signal leads to a hidden supply depot.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Smuggler's Path\",\n    \"trail_id\": \"rumor_trail.smugglers_path\",\n    \"hint_theme\": \"Whispers of a secret route to the core.\",\n    \"clue_templates\": [\"A smuggler mentions a shortcut.\", \"An old map shows a hidden gate.\"],\n    \"discovery_type\": \"hidden_route\",\n    \"rarity\": \"uncommon\",\n    \"payoff\": \"Access to a high-value trade route.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The gates lead further into the unknown.\",\n    \"new_system_reveal_rule\": \"New systems appear as you reach the edge.\",\n    \"future_faction_te_ease\": \"Rumors of a distant, desperate colony exist.\",\n    \"future_ore_or_upgrade_tease\": \"Rare minerals are found in unstable zones.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regen_scarcity_crisis\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_arc\",\n      \"description\": \"New arcs appear when the current arc ends.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Keep it dry and cynical.\",\n    \"fallback_rule\": \"If a quest fails, offer an alternative path.\",\n    \"banned_repeats\": [\"chosen one\", \"destiny\", \"prophecy\", \"ancient signal\"]\n  },\n  \"story_questions_for__future_generation\": [\n    \"What is the source of the orbital debris?\",\n    \"Why are the factions fighting over resources?\",\n    \"How did the smuggling routes become so valuable?\",\n    \"Who owns the remaining high-value cargo?\",\n    \"Where is the nearest stable trade route?\"\n  ]\n}",
