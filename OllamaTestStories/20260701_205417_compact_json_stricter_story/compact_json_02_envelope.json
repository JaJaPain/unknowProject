  "response": "{\"campaign_title\": \"Echoes of the Void\",\n  \"campaign_subtitle\": \"The Scarcity Crisis\",\n  \"campaign_logline\": \"A desperate pilot navigates a crumbling economy and shifting loyalties in the outer rim.\",\n  \"campaign_pitch\": \"Resource shortages are destabilizing the inner systems. You must navigate the friction between three expanding powers.\",\n  \"campaign_story_summary\": \"The Zenith Corporation seeks to monopolize energy cores. The Aurelia Collective values decentralized trade routes. The Vanguard protects the borders against pirates. You start as a pilot seeking enough credits to refuel your ship.\",\n  \"tone\": \"Dry, gritty frontier humor.\",\n  \"opening\": {\n    \"status_quo\": \"The local sector is suffering from severe fuel shortages.\",\n    \"visible_crisis\": \"Pirates are raiding trade convoys and stealing essential supplies.\",\n    \"hidden_crisis\": \"A massive decline in natural energy deposits is causing systemic instability.\",\n    \"why_now\": \"Recent blockade measures have forced traders to take riskier routes.\",\n    \"player_role\": \"You are a freelance pilot trying to stay solvent.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why is the fuel shortage so sudden and severe?\",\n    \"false_answer\": \"The shortages are caused by pirate raids on supply lines.\",\n    \"true_answer_hint\": \"A secret industrial project is draining the local energy fields.\",\n    \"long_term_reveal_direction\": \"The true cause involves deep-space mining infrastructure.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker and contract handler.\",\n    \"secret_angle\": \"She monitors the flow of illegal trade data.\",\n    \"address_rule\": \"Refer to her as a broker or fixer.\",\n    \"never_reveal_rule\": \"Her true purpose is hidden from all observers.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith seeks to control the energy market through heavy-handed tactics.\",\n    \"aurelia_problem\": \"Aurelia wants to keep trade routes open for independent traders.\",\n    \"vanguard_problem\": \"Vanguard is struggling to maintain safety in a lawless zone.\",\n    \"conflict_triangle\": \"The three factions are competing for the last known energy hubs.\",\n    \"neutral_space_pressure\": \"Independent pilots must choose sides or risk being stranded.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Scarcity Hunt\",\n    \"goal\": \"Secure enough fuel to reach a stable station.\",\n    \"opening_incident\": \"A cargo ship is intercepted by a pirate vessel.\",\n    \"midpoint_turn\": \"You find a shipment of high-grade energy cores.\",\n    \"finale\": \"You deliver the haul and gain your first contract from Kaelen.\",\n  \"player_takeaway\": \"Survival in this sector requires finding reliable allies.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"The Last Shipment\",\n    \"reason\": \"A shipment of cargo is being contested by a pirate ship.\",\n    \"enemy_identity\": \"Reaver-class scout ship.\",\n    \"enemy_knows\": \"The pirate knows the value of the haul.\",\n    \"aftershock\": \"You find a log indicating the pirates are desperate.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"Flickering Beacons\",\n    \"signal\": \"A rhythmic pulse from an abandoned mining station.\",\n    \"first_appearance\": \"Detected during the first jump to a new sector.\",\n    \"escalation\": \"The frequency of the pulses increases as you approach hubs.\",\n    \"payoff_hint\": \"The beacons are linked to the automated mining network.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Ghost Route\",\n    \"trail_id\": \"rumor_trail.ghost_route\",\n    \"hint_theme\": \"Whispers of a hidden trade route.\",\n     \"clue_templates\": [\"\\\"They say the old path is still active.\\\"\", \"\\\"The signal is faint but steady.\\\"\"],\n    \"discovery_type\": \"secret_route\",\n    \"rarity\": \"uncommon\",\n    \"payoff\": \"A shortcut through a hazardous zone.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The next gate leads to systems with more stable resources.\",\n    \"new_system_reveal_rule\": \"New systems are revealed only when the player enters a gate.\",\n    \"future_faction_tease\": \"Rumors of a distant, militant group called the Iron Reach.\",\n    \"future_ore_or_upgrade_tease\": \"Rare minerals found in deep-space mining zones.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regen_scarcity_hunt\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When Act 1 is complete, reveal the next stage of the scarcity crisis.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Use dry, gritty frontier humor.\",\n    \"fall_back_rule\": \"If a player action is not specified, default to a trade-focused outcome.\",\n    \"banned_repeats\": [\"chosen one\", \"destiny\", \"prophecy\", \"ancient signal\"]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What are the consequences of choosing a side in the conflict?\",\n    \"Why is the energy crisis causing such extreme measures?\",\n    \"How does Kaelen's role as a fixer affect her knowledge of the rest of world?\",\n    \"Who is funding the system-wide fuel shortage?\",\n    \"Where is the source of the hidden mining infrastructure?\"\n  ]\n}",
