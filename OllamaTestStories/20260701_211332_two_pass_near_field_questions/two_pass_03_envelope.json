  "response": "{\"campaign_title\": \"Ironbound Reach\",\n  \"campaign_subtitle\": \"The Scarcity of Steel\",\n  \"campaign_logline\": \"A struggling pilot navigates a decaying industrial zone where corporate greed and resource scarcity create a volatile trade landscape.\",\n  \"campaign_pitch\": \"You are an independent pilot in a dying sector. Zenith, Aurelia, and Vanguard compete for dwindling resources. You take contracts to survive. A hidden economic collapse is looming.\",\n  \"campaign_story_summary\": \"A broke pilot navigates the Ironbound Reach. Kaelen acts as your primary broker and fixer. You intercept a Reaver ship in a shipping lane. Zenith seeks expansion, while Aurelia controls trade routes. The recurring clue of 'Void-Stitched' cargo manifests appears. A systemic economic collapse threatens local stability. Act 1 focuses on securing basic supplies.\",\n  \"tone\": \"Dry, gritty industrial atmosphere with dark humor regarding the cost of survival.\",\n  \"opening\": {\n    \"status_quo\": \"The sector is a graveyard of heavy industry and aging infrastructure.\",\n    \"visible_crisis\": \"Resource shortages are causing desperate trade maneuvers by all factions.\",\n    \"hidden_crisis\": \"A massive industrial collapse is destabilizing the local economy.\",\n    \"why_now\": \"Supply lines have been cut, forcing independent pilots into high-risk zones.\",\n    \"player_role\": \"You are a debt-ridden pilot seeking to pay off your ship's maintenance fees.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why is the 'Void-Stitched' cargo so highly valued by all three factions?\",\n    \"false_answer\": \"The cargo contains illegal high-tech components for black market trade.\",\n    \"true__hint\": \"The material is a byproduct of an experimental, failing industrial process.\",\n    \"long_term_reveal_direction\": \"The truth involves the physical cost of manufacturing in a dying infrastructure.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker and fixer for independent pilots.\",\n    \"secret_angle\": \"She monitors trade flows to identify emerging economic instability.\",\n    \"address_rule\": \"Treat her as a professional, no-nonsense contract handler.\",\n    \"never_reveal_rule\": \"Her past and the true nature of her data collection are secrets.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith is aggressively expanding its territory to secure raw materials.\",\n    \"aurelia_problem\": \"Aurelia's monopoly on trade routes is failing due to infrastructure decay.\",\n    \"vanguard_problem\": \"Vanguard struggles to maintain security in the increasingly lawless zones.\",\n    \"conflict_triangle\": \"Zenith wants land, Aurelia wants control, and Vanguard seeks stability.\",\n    \"neutral_space_pressure\": \"Independent pilots are being squeezed by rising costs and pirate activity.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Scarcity of Steel\",\n    \"goal\": \"Secure enough scrap and supplies to stabilize your ship's status.\",\n    \"opening_incident\": \"You intercept a Reaver-like vessel carrying 'Void-Stitched' cargo.\",\n    \"midpoint_turn\": \"Kaelen offers a high-risk contract involving an Aurelia trade route.\",\n    \"finale\": \"You successfully deliver the cargo and earn enough to repair your ship.\",\n  \"player_takeaway\": \"You realize that survival in the Ironbound Reach is a matter of negotiation.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"The Scarcity of Steel\",\n    \"reason\": \"A Reaver-like vessel was spotted in a high-traffic shipping lane.\",\n    \"enemy_identity\": \"A lone, derelict-looking ship with heavy plating and no markings.\",\n    \"enemy_knows\": \"The ship is automated or piloted by a desperate scavenger.\",\n    \"after_effect\": \"You gain scrap metal and the first piece of 'Void-Stitched' cargo.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"Void-Stitched Cargo\",\n    \"signal\": \"A unique marking on shipping manifests for high-value items.\",\n    \"first_appearance\": \"Found on the manifest of the Reaver ship in the starter mission.\",\n    \"escalation\": \"The term appears in Kaelen's contracts and Aurelia trade logs.\",\n    \"payoff_hint\": \"It points toward a looming industrial collapse in the manufacturing sector.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Ghost of the Forge\",\n    \"trail_id\": \"rumor_trail.ghost_of_the_forge\",\n    \"hint_theme\": \"Rumors of a hidden, abandoned forge in the industrial zone.\",\n     \"clue_templates\": [\"A whisper of a foundry that still hums with power.\", \"A log entry mentioning a secret manufacturing site.\"],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"local\",\n    \"payoff\": \"Discovery of an old, high-capacity storage vault for rare parts.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"Reports of a stable gate leading to the next industrial sector.\",\n    \"new_system_reveal_rule\": \"Do not name specific systems or factions beyond Zenith, Aurelia, and Vanguard.\",\n    \"future_pressure_tease\": \"The growing demand for 'Void-Stitched' cargo will increase your risk.\",\n    \"future_ore_or_upgrade_tease\": \"Rumors of high-grade ore and advanced components in the outer reaches.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regen_industrial_core\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When a major arc is completed, new content is added to the horizon.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Dry, slightly dark humor regarding the cost of survival.\",\n    \"fallback\": \"If no contract is available, Kaelen offers a standard delivery mission.\",\n    \"banned_repeats\": [\"chosen one\", \"destiny\", \"ancient signal\", \"ghost signal\", \"mysterious pulse\"]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What are the consequences of your trade choices in the larger narrative?\",\n    \"Why do Zenith and Aurelia compete for resources over a dying infrastructure?\",\n    \"How does Kaelen's role as a broker influence her interactions with you?\",\n    \"Who is likely to be hired by both Vanguard and Aurelia to secure cargo?\",\n    \"Why is the 'Void-Stitched' cargo so valuable during this economic crisis?\"\n  ]\n}",
