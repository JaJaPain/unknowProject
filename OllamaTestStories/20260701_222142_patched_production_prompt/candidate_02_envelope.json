  "response": "{\n  \"campaign_title\": \"The Interest Margin\",\n  \"campaign_logline\": \"In a sector owned by creditors, your oxygen is a subscription service and the only thing cheaper than the interest rates is the bail.\",\n  \"opening_situation\": \"You start with a debt-leveraged ship in Aurelia's docking bays. Zenith patrols for 'delinquent assets,' while Vanguard secures the heavy manufacturing hubs.\",\n  \"main_mystery\": \"The true owners of the local infrastructure are not who they claim to be, but rather a shell company managing a massive liquidation of state assets.\",\n  \"act_1_outline\": [\n    \"Navigate Aurelia's shipping lanes while dodging repossession drones and high-interest collection agents.\",\n    \"Identify 'Ghost Accounts' in the Zenith ledger that allow for illicit smuggling of basic supplies.\",\n    \"Negotiate a temporary reprieve from the debt-hold by performing a risky escort into Vanguard territory.\"\n  ],\n  \"long_term_reveal\": \"The local government didn't collapse; it was sold to a private equity firm that pays employees in scrip only valid at company stores.\",\n  \"tone\": \"Dry, cynical, and corporate-noir. Jokes should focus on the absurdity of bureaucratic bureaucracy.\",\n  \"core_pressure\": \"Debt cycles and resource scarcity under privatized infrastructure.\",\n  \"kaelen_rule\": \"Kaelen is a fixer who knows too much about the ledger; she cannot die and her motives remain ambiguous.\",\n  \"faction_reveal_rule\": \"New factions are only revealed upon entering new systems via gates. No forward references.\",\n  \"humor_rule\": \"Dry, dark humor regarding corporate bureaucracy and survival. Avoid catchphrases and repetitive tropes.\",\n  \"address_rule\": \"Keep all strings under 140 characters unless otherwise specified.\",\n  \"fallback_rule\": \"If a query is ambiguous, default to the nearest applicable narrative constraint in the core lane.\",\n  \"story_horizon_rule\": \"Trigger new content based on metric thresholds to ensure continuous progression.\",\n  \"story_arcs\": [\n    {\n      \"name\": \"The Interest Hike\",\n      \"summary\": \"Evade Vanguard enforcers while smuggling 'off-book' oxygen canisters from the industrial zones.\"\n    }\n  ],\n  \"rumor_trails\": [\n    {\n      \"name\": \"The Ledger Ghost\",\n      \"trail_id\": \"rumor_trail.ledger_ghost_audit\",\n      \"clue_count\": 2,\n      \"hint_theme\": \"Accounting anomalies in the Aurelia sector.\",\n      \"clue_templates\": [\n        \"A corrupted log of 'unclaimed' debt certificates from a defunct mining station.\",\n        \"A series of encrypted messages between two high-level execs regarding a 'Zero-Sum' settlement.\"\n      ],\n      \"discovery_type\": \"endgame_easter_egg\",\n      \"rarity\": \"legendary\",\n      \"payoff\": \"Find the hidden offshore account where the true ownership papers are buried.\"\n    }\n  ],\n  \"regeneration_triggers\": [\n    {\n      \"id\": \"system_exhaustion_trigger\",\n      \"metric\": \"active_story_arcs_remaining\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the current arc concludes, generate a new narrative hook for the next system.\"\n    }\n  ],\n  \"expansion_rules\": [\n    \"Append a new horizon when 'active_story_arcs_remaining' hits 0.\",\n    \"Never retroactively change established player choices or known faction statuses.\"\n  ],\n  \"banned_repeats\": [\n    \"Zenith [Noun]\",\n    \"Great Silence\",\n    \"Prophecy\",\n    \"Chosen One\"\n  ]\n}",
