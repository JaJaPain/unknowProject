  "response": "{\n  \"campaign_title\": \"The Scrap-Heap Ledger\",\n  \"campaign_logline\": \"Salvage the wreckage of a disgraced corporate fleet while navigating insurance fraud and maritime disputes in the Zenith sector.\",\n  \"opening_situation\": \"You find a drifting transport near Zenith. The hull is torn, the logs are corrupted, and the manifest lists cargo that shouldn't exist.\",\n  \"main_mystery\": \"Who authorized the illegal 'ghost shipments' and why was the owner of the wreckage scrubbed from public records?\",\n  \"act_1_outline\": [\n    \"Secure the first wreck near Aurelia while dodging local enforcement for 'unauthorized salvage'.\",\n    \"Decipher a corrupted data-chit in a scrap pile that hints at systemic insurance fraud.\",\n    \"Negotiate with Vanguard representatives to trade recovered parts for legal clearance.\"\n  ],\n  \"long_term_reveal\": \"The 'ghost' ships were actually corporate assets hidden from tax audits, and the owner sold them off as phantom entities.\",\n  \"tone\": \"Dry, cynical, slightly dark humor regarding maritime law and corporate greed.\",\n  \"core_pressure\": \"Regulatory scrutiny and cargo weight limits.\",\n  \"kaelen_rule\": \"Kaelen is a dry-witted logistics expert; she cannot die or reveal her full past.\",\n  \"faction_reveal_rule\": \"New factions only revealed via gate jumps to unexplored systems.\",\n  \"humor_rule\": \"Deadpan jokes about the absurdity of space law and cosmic scale bureaucracy.\",\n  \"address_rule\": \"Keep all descriptions under 140 characters unless specified.\",\n  \"fallback_rule\": \"If a query is ambiguous, default to procedural salvage options.\",\n  \"story_horizon_rule\": \"Append new arcs when metrics hit threshold. Do not retcon player choices.\",\n  \"story_arcs\": [\n    {\n      \"name\": \"The Paper Trail\",\n      \"summary\": \"Trace the ownership of a series of 'ghost' ships to uncover who is laundering corporate assets.\"\n    }\n  ],\n  \"rumor_trails\": [\n    {\n      \"name\": \"The Ghost Ledger\",\n      \"trail_id\": \"rumor_trail.ghost_ledger_scout\",\n      \"clue_count\": 2,\n      \"hint_theme\": \"Illegal cargo manifests.\",\n      \"clue_templates\": [\n        \"A frantic log from a frustrated clerk about 'Item 404'.\",\n        \"A recurring serial number found on three different ship types.\"\n      ],\n      \"discovery_type\": \"endgame_easter_egg\",\n      \"rarity\": \"legendary\",\n      \"payoff\": \"Unlocks the secret location of a hidden offshore bank account for high-value trade.\"\n    }\n  ],\n  \"regeneration_triggers\": [\n    {\n      \"id\": \"add_new_sector_content\",\n      \"metric\": \"active_story_arcs_remaining\",\n      \"threshold\": 0,\n      \"action\": \"append_story_arc\",\n      \"description\": \"Add a new arc when the current main chain concludes.\"\n    }\n  ],\n  \"expansion_rules\": [\n    \"Append arcs to existing logs.\",\n    \"No retconning of choice history.\"\n  ],\n  \"banned_repeats\": [\n    \"Zenith [Noun]\",\n    \"Great Silence\",\n    \"Prophecy\"\n  ]\n}",
