  "model": "gemma4:12b",
  "created_at": "2026-07-02T02:22:46.2981075Z",
  "response": "{\n  \"campaign_title\": \"The Methane Veil\",\n  \"campaign_logline\": \"In the toxic haze of the Aurelia Reach, mining claims are failing, life support is failing faster, and someone is profiting from the air you can't breathe.\",\n  \"opening_situation\": \"You arrive at Zenith to find the atmosphere scrubbers choking on 'Heavy-M' particulates. Kaelen warns that the local refineries are cutting corners on safety filters to maximize yield.\",\n  \"main_mystery\": \"The systematic poisoning of the Aurelia sector is not an accident, but a deliberate strategy to devalue property and seize industrial licenses.\",\n  \"act_1_outline\": [\n    \"Investigate the 'malfunctioning' scrubbers in the Zenith refinery hub.\",\n    \"Negotiate with Vanguard security over illegal dumping zones near civilian habitats.\",\n    \"Trace the source of the toxic particulate back to a hidden manufacturing hub.\"\n  ],\n  \"long_term_reveal\": \"The corporate owners know the air is lethal but are waiting for 'natural' casualties to bypass safety regulations and claim ownership of the mineral veins.\",\n  \"tone\": \"Dry, cynical, industrial-gothic.\",\n  \"core_pressure\": \"Oxygen depletion and toxic buildup in base stations.\",\n  \"kaelen_rule\": \"Kaelen is a local scavenger. She cannot die; her origins remain ambiguous as she simply knows 'too much' about the chemistry of the void.\",\n  \"faction_reveal_rule\": \"Only Zenith, Aurelia, and Vanguard are known. New factions revealed only via jump gates.\",\n  \"humor_rule\": \"Dry, sarcastic remarks regarding corporate negligence and the absurdity of space-labor safety.\",\n  \"address_rule\": \"All narrative beats must stay within the industrial/ecological hazard lane.\",\n  \"fallback_rule\": \"If a choice is ambiguous, default to a complication involving equipment degradation or supply shortages.\",\n  \"story_horizon_rule\": \"Trigger expansion when exploration metrics drop below 30% of current total.\",\n  \"story_arcs\": [\n    {\n      \"name\": \"The Cost of Breathing\",\n      \"summary\": \"Uncover the deliberate sabotage of air filtration systems to force workers into high-risk, high-reward extraction zones.\"\n    }\n  ],\n  \"rumor_trails\": [\n    {\n      \"name\": \"The Ghost Pipeline\",\n      \"trail_id\": \"rumor_trail.ghost_pipeline_alpha\",\n      \"clue_count\": 2,\n      \"hint_theme\": \"Corrupted data logs from a discarded maintenance drone.\",\n      \"clue_templates\": [\n        \"A series of encrypted coordinates marked 'Waste Zone B'.\",\n        \"An old blueprint showing a hidden bypass for the main refinery.\"\n      ],\n      \"discovery_type\": \"hidden_discovery\",\n      \"rarity\": \"rare\",\n      \"payoff\": \"Discovery of an abandoned, high-yield mineral vein untouched by current industrial rot.\"\n    }\n  ],\n  \"regeneration_triggers\": [\n    {\n      \"id\": \"scarcity_trigger_01\",\n      \"metric\": \"prepared_systems_remaining\",\n      \"threshold\": 2,\n      \"action\": \"append_story_arc\",\n      \"description\": \"When infrastructure fails, generate a new arc focused on local resource recovery.\"\n    }\n  ],\n  \"expansion_rules\": [\n    \"Do not reveal future factions until the player passes a physical jump gate.\",\n    \"New minerals must be tied to specific contaminated zones identified in the loot table.\"\n  ],\n  \"banned_repeats\": [\n    \"Zenith [Noun]\",\n    \"Great Silence\",\n    \"Ancient Signal\",\n    \"Chosen One\"\n  ]\n}",
