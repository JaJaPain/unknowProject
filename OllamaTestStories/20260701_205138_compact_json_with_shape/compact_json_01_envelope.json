  "response": "{\"campaign_title\": \"Dust of the Reach\",\n  \"campaign_subtitle\": \"The Scavenger's Toll\",\n  \"campaign_logline\": \"A broke pilot finds a strange signal in a derelict sector.\",\n  \"campaign_pitch\": \"Navigate the friction between three rival factions. Secure your survival and uncover why some sectors remain silent.\",\n  \"campaign_story_summary\": \"The Reach is a contested mining zone. Zenith seeks control of the trade routes. Aurelia values the ancient infrastructure. Vanguard guards the frontier borders. You are an independent pilot seeking profit. Every haul brings you closer to the truth.\",\n  \"tone\": \"Dry, gritty frontier humor.\",\n  \"opening\": {\n    \"status_quo\": \"Independent pilots navigate a lawless mining zone.\",\n    \"visible_crisis\": \"The three main factions are escalating their presence.\",\n    \"hidden_crisis\": \"A strange signal pulse is destabilizing local navigation gates.\",\n    \"why_now\": \"Trade routes are tightening, making survival harder for independents.\",\n    \"player_role\": \"You are a debt-ridden pilot seeking work.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why do the gate signals pulse?\",\n    \"false_answer\": \"It is a malfunctioning automated defense system.\",\n    \"true_answer_hint\": \"The pulses correlate with specific orbital patterns.\",\n    \"long_term_reveal_direction\": \"Leave the actual cause for future campaigns.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker, fixer, and contract handler.\",\n    \"secret_angle\": \"She observes the gate pulse patterns privately.\",\n    \"address_rule\": \"Refer to her as a broker or fixer.\",\n    \"never_reveal_rule\": \"Her true purpose remains unknown.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith wants to monopolize the trade routes.\",\n    \"aurelia_problem\": \"Aurelia seeks to preserve the old infrastructure.\",\n    \"vanguard_problem\": \"Vanguard enforces strict border security protocols.\",\n    \"conflict_triangle\": \"Each faction struggles for dominance in the Reach.\",\n    \"neutral_space_pressure\": \"Independent pilots are squeezed between their demands.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Broken Circuit\",\n    \"goal\": \"Secure a stable delivery route.\",\n    \"opening_incident\": \"A pirate ship is intercepted by a local patrol.\",\n    \"midpoint_turn\": \"You find a cargo container with encrypted data.\",\n    \"finale\": \"You deliver the package and receive your first payment.\",\n    \"player_takeaway\": \"The Reach is dangerous but profitable.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"First Strike\",\n    \"reason\": \"Tutorial mission for basic combat mechanics.\",\n    \"enemy_identity\": \"A lone Reaver scout ship.\",\n    \"enemy_knows\": \"It does not know you are there.\",\n    \"aftershock\": \"The wreckage provides scrap metal and fuel.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"Ghost Signal\",\n    \"signal\": \"A rhythmic pulse in the gate sensors.\",\n    \"first_appearance\": \"Detected during your first delivery.\",\n    \"escalation\": \"The frequency of pulses increases as you move.\",\n    \"payoff_hint\": \"Signals are linked to the gate network.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Old Way\",\n    \"trail_id\": \"rumor_trail.old_way\",\n    \"hint_theme\": \"Ancient technology and forgotten paths.\",\n    \"clue_templates\": [\"A whisper of a buried vault.\", \"A signal that echoes in the void.\"],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"rare\",\n    \"payoff\": \"Unlocks a secret route to an old station.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The gate pulses are becoming more frequent.\",\n    \"new_system_reveal_rule\": \"Do not reveal future frontier factions.\",\n    \"future_faction_tease\": \"None. Keep the focus on the local sector.\",\n    \"future_ore_or_upgrade_tease\": \"Uncover a rare mineral from an old site.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regen_gate_pulse\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the first act ends, add a new gate pulse.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Use dry, gritty frontier humor.\",\n    \"fallback_rule\": \"If a prompt is unclear, use generic space-scavenger talk.\",\n    \"banned_repeats\": [\"gate\", \"signal\", \"reaver\", \"broker\", \"fixer\"]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What caused the primary gate pulse?\",\n    \"Why ares's infrastructure is being preserved?\",\n    \"100% of the content should be not-yet-known.\",\n    \"The fate of the rest of thes world is unknown.\",\n    \"50% of the core mystery remains hidden.\"\n  ]\n}",
