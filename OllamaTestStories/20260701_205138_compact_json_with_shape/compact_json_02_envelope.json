  "created_at": "2026-07-02T00:52:40.6794627Z",
  "response": "{\"campaign_title\": \"Echoes of the Void\",\n  \"campaign_subtitle\": \"The Broken Rim\",\n  \"campaign_logline\": \"A desperate pilot navigates a fractured frontier and the secrets hidden in the silence.\",\n  \"campaign_pitch\": \"You are a broke pilot trying to stay afloat. Navigate political tension between three rival factions while uncovering local mysteries.\",\n  \"campaign_story_summary\": \"The Rim is a lawless zone where trade routes are just memories. Zenith seeks order through heavy control. Aurelia values freedom over safety. Vanguard fights for survival in the harsh void. You find work from Kaelen to keep your ship running. Every contract brings you closer to the truth of the silence.\",\n  \"tone\": \"Dry, gritty frontier humor with a touch of cosmic dread.\",\n  \"opening\": {\n    \"status_quo\": \"Independent pilots fly cargo and ore between outposts.\",\n    \"visible_crisis\": \"The three main factions are locked in a cold war.\",\n    \"hidden_crisis\": \"Strange signals are disrupting the local warp gates.\",\n    \"why_now\": \"Fuel costs have spiked, making independent survival difficult.\",\n    \"player_role\": \"A broke pilot seeking any available contract.\"\n  },\n  \"mystery\": {\n    \"question\": \"What is causing the gate disruptions?\",\n    \"false_answer\": \"The signals are just interference from old mining equipment.\",\n    \"true_answer_hint\": \"The gates react to something deep in the void.\",\n    \"long_term_reveal_direction\": \"The source of the signal remains unknown and distant.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker, fixer, and contract handler.\",\n    \"secret_angle\": \"She knows more about the gate signals than she admits.\",\n    \"address_rule\": \"Refer to her as a broker or fixer.\",\n    \"never_reveal_rule\": \"Never reveal her origin or true purpose.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"They want to centralize all gate access for safety.\",\n    \"aurelia_rule\": \"They favor decentralized, free-trade routes and pirate zones.\",\n    \"vanguard_problem\": \"They are struggling to maintain infrastructure in the wilder rim.\",\n    \"conflict_triangle\": \"Zenith wants control, Aurelia wants freedom, Vanguard is caught in between.\",\n    \"neutral_space_pressure\": \"Pirates and scavengers thrive where the factions fail.\"\n  },\n  \"act_1\": {\n    \"name\": \"The First Contract\",\n    \"goal\": \"Secure enough credits to repair your primary engine.\",\n    \"opening_incident\": \"Kaelen offers a high-paying contract for a delivery of rare minerals.\",\n    \"midpoint_turn\": \"You encounter a pirate ship during the transport.\",\n    \"finale\": \"You successfully deliver the cargo and receive a reward.\",\n    \"player_takeaway\": \"The first few contracts are just to survive.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"Clear the Path\",\n    \"reason\": \"A simple combat tutorial for the player.\",\n    \"enemy_identity\": \"A lone Reaver-class scout ship.\",\n    \"enemy_knows\": \"The enemy is unaware of your presence.\",\n    \"aftershock\": \"You find a data chip containing local trade routes.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"The Ghost Signal\",\n    \"signal\": \"A rhythmic pulse every 30 seconds.\",\n    \"first_appearance\": \"Detected during the first delivery mission.\",\n    \"escalation\": \"The signal grows stronger as you move toward gate hubs.\",\n    \"payoff_hint\": \"The signal is linked to the gate mechanism.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Lost Mine\",\n    \"trail_id\": \"rumor_trail.lost_mine\",\n    \"hint_theme\": \"Abandoned mining sites and old equipment.\",\n    \"clue_templates\": [\"A ghost mine is rumored to be active.\", \"Some say the ore there is highly refined.\"],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"rare\",\n    \"payoff\": \"Discovery of a high-yield mining site.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The gate pulse is consistent across all hubs.\",\n    \"new_system_reveal_rule\": \"Do not reveal future frontier factions.\",\n    \"future_faction_tease\": \"Rumors of other groups exist but are not named.\",\n    \"future_ore_or_upgrade_tease\": \"Rare minerals offer significant engine upgrades.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regen_gate_signal\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the first act is complete, add a new gate signal.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Use dry, gritty frontier humor.\",\n    \"fallback_rule\": \"If a quest log is missing, default to 'Contract in progress'.\",\n    \"banned_repeats\": [\"scout\", \"pilot\", \"pilot_role\"]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What are the other factions' hidden goals?\",\n    \"system_name_s01_title\",\n    \"system_name_s02_title\",\n    \"system_name_s03_title\",\n    \"500 words of lore about the void.\"\n  ]\n}",
