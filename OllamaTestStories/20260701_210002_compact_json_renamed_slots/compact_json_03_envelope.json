  "response": "{\"campaign_title\": \"Echoes of the Void\",\n  \"campaign_subtitle\": \"The Dust of Dead Systems\",\n  \"campaign_logline\": \"A desperate pilot navigates a collapsing trade corridor.\",\n  \"campaign_pitch\": \"Navigate the decaying infrastructure of the Aurelia Corridor. Balance the demands of three rival factions while uncovering why the supply lines are failing.\",\n  \"campaign_story_summary\": \"The Aurelia Corridor is choking on its own logistics. Zenith wants to secure the main gates, Vanguard seeks to protect trade routes, and Aurelia struggles to maintain their infrastructure. A pilot's cargo becomes a point of contention. You must decide who owns the future of the corridor.\",\n  \"tone\": \"Dry, gritty frontier humor. Low-stakes survival with high-stakes politics.\",\n  \"opening\": {\n    \"status_quo\": \"The Aurelia Corridor is a primary trade route between three major hubs.\",\n    \"visible_crisis\": \"Supply lines are failing due to aging gate infrastructure and pirate activity.\",\n    \"hidden_crisis\": \"A logistics software glitch is slowly corrupting the automated navigation systems.\",\n    \"why_now\": \"The nearest hub's main processor is scheduled for a hard reset in thirty days.\",\n    \"player_role\": \"An independent pilot seeking to pay off mounting debts.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why are the automated navigation systems failing?\",\n    \"false_answer\": \"Pirates are hacking the gate network to create a dead zone.\",\n    \"true_answer_hint\": \"The system is reacting to an unforeseen geological shift in the nearby nebula.\",\n    \"long_term_reveal_direction\": \"The corruption is actually an adaptive response to environmental hazards.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker, fixer, and contract handler.\",\n    \"secret_angle\": \"She knows the extent of the navigation system's degradation.\",\n    \"address_rule\": \"Refer to her as a broker or fix-it specialist.\",\n    \"never_reveal_rule\": \"Never reveal her knowledge of the gate systems.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith seeks to consolidate power by monopolizing the gate network's maintenance.\",\n    \"aurelia_problem\": \"Aurelia is struggling to maintain their aging infrastructure with limited resources.\",\n    \"vanguard_problem\": \"Vanguard wants to secure trade routes against increasing pirate activity.\",\n    \"conflict_triangle\": \"Zenith wants control, Aurelia needs help, and Vanguard wants safety.\",\n    \"neutral_space_pressure\": \"The local pirates are becoming more aggressive as the corridor's security thins.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Broken Path\",\n    \"goal\": \"Secure a stable route through the Aurelia Corridor.\",\n    \"opening_itement_incident\": \"A cargo shipment of gate components is intercepted by a scavenger ship.\",\n    \"midpoint_turn\": \"You discover that several gates are no longer responding to standard protocols.\",\n    \"finale\": \"You choose which faction's protocol will be prioritized for the next cycle.\",\n    \"player_takeaway\": \"The corridor is failing, and you must decide who leads it.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"Scavenger's Toll\",\n    \"reason\": \"You need to clear a path through a debris-heavy sector.\",\n    \"enemy_identity\": \"A lone scavenger ship.\",\n    \"enemy_knows\": \"The scavenger is trying to hide in the debris.\",\n    \"after_effect\": \"You gain access to a stable gate and a small amount of scrap metal.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"Ghost Signals\",\n    \"signal\": \"A recurring 10-second pulse from an abandoned relay station.\",\n    \"first__appearance\": \"The first time you enter the gate network.\",\n    \"escalation\": \"The signal pulses faster as you approach the core of the corridor.\",\n    \"payoff_hint\": \"The signal is a beacon for automated maintenance drones.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Shadowy Broker\",\n    \"trail_id\": \"rumor_trail.shadow_broker\",\n    \"hint_theme\": \"Whispers of a broker who can find anything.\",\n    \"clue_templates\": [\n        \"I heard she can get you a contract that actually pays well.\",\n        \"She's the told-be-told for fixers in this sector.\"\n    ],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"local\",\n    \"payoff\": \"A high-value contract from Kaelen directly.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The gate network is expanding into the unknown.\",\n    \"new__system_reveal_rule\": \"Do not mention other factions until they are encountered.\",\n    \"future_pressure_tease\": \"Reports of increasing pirate activity in outer sectors.\",\n    \"future_ore_or_upgrade_tees_tease\": \"Rumors of rare minerals found in the nebula's core.\",\n    \"regeneration_trigger\": {\n      \"id\": \"gate_expansion_trigger\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the first act ends, add new sector gates.\"\n    }\n  }\n}",
