  "created_at": "2026-07-02T01:02:03.8682529Z",
  "response": "{\"campaign_title\": \"Echoes of the Void\",\n  \"campaign_subtitle\": \"The Dust of Industry\",\n  \"campaign_logline\": \"A desperate pilot navigates the friction between three competing corporate giants.\",\n  \"campaign_pitch\": \"You are a freelancer in a dying trade route. Balance the demands of Zenith, Aurelia, and Vanguard while surviving the lawless fringe.\",\n  \"campaign_story_summary\": \"The orbital lanes are thinning due to heavy mining. Three factions struggle for control over remaining resources. You navigate their conflicts as an independent contractor. Kaelen provides your only steady link to information. The truth of the resource depletion is hidden in the logs.\",\n  \"tone\": \"Dry, gritty frontier humor.\",\n  \"opening\": {\n    \"status_quo\": \"Trade routes are failing due to heavy industrial exhaustion.\",\n    \"visible_crisis\": \"The three factions are fighting over dwindling mineral deposits.\",\n    \"hidden_crisis\": \"A systemic failure in the gate network infrastructure is collapsing.\",\n    \"why_now\": \"Resource scarcity has forced the corporations into open conflict.\",\n    \"player_role\": \"An independent pilot seeking to pay off heavy debts.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why are the trade routes failing?\",\n    \"false_answer\": \"The resources are physically exhausted by mining.\",\n    \"true_answer_hint\": \"The gate network is actively collapsing into a void of data.\",\n    \"long_term_reveal_direction\": \"The infrastructure failure is an intentional decommissioning of the sector.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker, fixer, and contract handler.\",\n    \"secret_angle\": \"She knows the gate network's instability is accelerating.\",\n    \"address_rule\": \"Refer to her as a broker or contractor.\",\n    \"never_reveal_rule\": \"Never reveal her knowledge of the infrastructure.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith wants to secure high-grade ores for their luxury line.\",\n    \"aurelia_problem\": \"Aurelia is struggling to keep their transport fleet operational.\",\n    \"vanguard_problem\": \"Vanguard seeks to establish a permanent military presence in the sector.\",\n    \"conflict_triangle\": \"Zenith wants resources, Aurelia needs logistics, Vanguard wants security.\",\n    \"neutral_space_pressure\": \"Pirates and scavengers thrive where corporate oversight is weak.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Broken Link\",\n    \"goal\": \"Secure a stable trade route for the local hub.\",\n    \"opening_incident\": \"A supply ship from Aurelia is intercepted by a pirate.\",\n    \"midpoint_turn\": \"You discover that the pirates are using stolen corporate tech.\",\n    \"finale\": \"You secure the route but realize the data logs are corrupted.\",\n    \"player_takeaway\": \"The local hub is no longer safe for independent pilots.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"Scrap of a Secret\",\n    \"reason\": \"A rogue scavenger ship is harassing trade lanes.\",\n    \"enemy_identity\": \"Reaver-class interceptor.\",\n    \"enemy_knows\": \"The pirate knows only the value of the scrap.\",\n    \"after_effect\": \"You find a data chip containing encrypted courier logs.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"Ghost Signal\",\n    \"signal\": \"A rhythmic pulse from an abandoned gate.\",\n    \"first_appearance\": \"The signal is heard during the first mission.\",\n    \"escalation\": \"The frequency of the pulses increases near jump points.\",\n    \"payoff_hint\": \"The signal is a distress call from a dying infrastructure.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Ghost Gate\",\n    \"trail_id\": \"rumor_trail.ghost_gate\",\n    \"hint_theme\": \"Abandoned infrastructure and decaying data.\",\n    \"clue_templates\": [\"A whisper of a gate that no longer connects to anything.\", \"A signal from a place that is not there.\"],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"rare\",\n    \"payoff\": \"Access to a hidden, derelict jump point.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"A distant gate leads toward the unknown.\",\n    \"new_system_reveal_rule\": \"New systems are revealed as you unlock more gates.\",\n    \"future_pressure_tease\": \"Rumors of a deeper crisis in the core sectors.\",\n    \"future_ore_or_upgrade_tease\": \"Rare minerals found only in high-risk zones.\",\n    \"regeneration_trigger\": {\n      \"id\": \"gate_trigger.collapse\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the first arc is finished, a new gate opens.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Use dry, slightly dark humor.\",\n    \"fallback\": \"If no content is available, use standard broker contract terms.\",\n    \"banned_repeats\": [\"chosen one\", \"destiny\", \"prophecy\", \"ghost signal\"]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What are the reasons for the gate network's collapse?\",\n    \"Why is Kaelen still active in this sector?\",\n    \"How many other pilots who attempted to turn the gates back on failed?\",\n    \"Who owns the current infrastructure of the sector?\",\n    \"Where is the core system that controls all jump points?\"\n  ]\n}",
