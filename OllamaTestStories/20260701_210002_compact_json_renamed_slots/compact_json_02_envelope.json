  "response": "{\"campaign_title\": \"Edges of the Void\",\n  \"campaign_subtitle\": \"The Last Outpost Supply Chain\",\n  \"campaign_logline\": \"A struggling pilot navigates a fractured supply chain between three competing corporations.\",\n  \"campaign_pitch\": \"You are an independent contractor in a dying trade route. You must navigate corporate greed and smuggling risks to keep the lights on.\",\n  \"campaign_story_summary\": \"The Zenith Corporation owns the primary mining veins. Aurelia seeks to monopolize the local trade routes. The Vanguard protects the border zones. You deliver supplies between their overlapping territories.\",\n  \"tone\": \"Dry, gritty frontier humor and high-stakes logistics.\",\n  \"opening\": {\n    \"status_quo\": \"The sector is a patchwork of corporate claims and lawless zones.\",\n    \"visible_crisis\": \"Supply lines are failing due to increasing pirate activity and heavy taxes.\",\n    \"hidden_crisis\": \"A massive shortage of high-grade fuel cells is destabilizing the local economy.\",\n    \"why_now\": \"The nearest refinery hub has just been decommissioned by a central authority.\",\n    \"player_role\": \"You are an independent pilot with a debt to Kaelen.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why is the fuel cell shortage so sudden?\",\n    \"false_answer\": \"The refinery was destroyed in a pirate raid.\",\n    \"true_answer_hint\": \"A private corporation is hoarding cells for an unknown project.\",\n    \"long_term_reveal_direction\": \"The hoard is being moved to a remote, undisclosed gate.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker and contract handler.\",\n    \"secret_angle\": \"She knows the secret locations of the hidden fuel cells.\",\n    \"address_rule\": \"Kaelen always refers to you as 'Captain'.\",\n    \"never_reveal_rule\": \"Never reveal her origin or any knowledge of the gate network.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith is struggling to maintain their mining infrastructure.\",\n    \"aurelia__problem\": \"Aurelia wants to seize Zenith's abandoned mines for themselves.\",\n    \"vanguard_problem\": \"Vanguard is losing control over the border zones.\",\n    \"conflict_triangle\": \"The three factions are fighting over the remaining high-grade fuel cells.\",\n    \"neutral_space_pressure\": \"Pirates and scavengers are moving into the gap left by the peace.\"\n  },\n  \"act_1\": {\n    \"name\": \"Broken Chains\",\n    \"goal\": \"Secure a stable supply route for local stations.\",\n    \"opening_incident\": \"Kaelen gives you your first contract to move fuel cells.\",\n    \"midpoint_turn\": \"You find an Aurelian shipment that is partially destroyed.\",\n    \"finale\": \"You establish a reliable trade route between the three sectors.\",\n    \"player_takeaway\": \"The local economy depends on your deliveries.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"Clear the Path\",\n    \"reason\": \"A pirate ship is blocking the primary supply lane.\",\n    \"enemy_identity\": \"Reaver-class scout ship.\",\n    \"enemy_knows\": \"The Reaver does not know who you are.\",\n    \"after_effect\": \"You earn your first payment and a reputation with Kaelen.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"Ghost Fuel\",\n    \"signal\": \"A faint, repeating pulse from an abandoned refinery.\",\n    \"first_appearance\": \"Detected during the first fuel delivery mission.\",\n    \"escalation\": \"The signal grows stronger as you approach the core.\",\n    \"payoff_hint\": \"The signal leads to a hidden stockpile of cells.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Shadowed Mine\",\n    \"trail_id\": \"rumor_trail.shadow_mine\",\n    \"hint_theme\": \"Rumors of an untouched mine and easy riches.\",\n    \"clue_templates\": [\"A local miner mentions a hidden vein.\", \"A smuggler talks about the 'Shadow' mine.\"],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"rare\",\n    \"payoff\": \"You find a hidden stash of high-grade ore.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The gate network is becoming increasingly unstable.\",\n    \"new_system_reveal_rule\": \"New systems are only revealed through discovered gates.\",\n    \"future_pressure_tease\": \"Reports of a growing pirate fleet in the outer rim.\",\n    \"future_ore_or_upgrade_tease\": \"Rumors of high-grade ore found in unexplored sectors.\",\n    \"regeneration_trigger\": {\n      \"id\": \"gate_trigger_s01\",\n       \"metric\": \"prepared_systems_remaining\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"Add a new gate and a related story arc.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Use dry, gritty humor about the other factions' incompetence.\",\n    \"fallback\": \"If a contract is told to be missing, report it as stolen.\",\n    \"banned_repeats\": [\"chosen one\", \"destiny\", \"prophecy\", \"signal\"]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What are the motives of the other corporations?\",\n    \"Why is the fuel cell shortage becoming more severe?\",\n    \"How does the lure of the other gates lead to exploration?\",\n    \"Who is hoarding the fuel cells for their purpose?\",\n    \"Why is Kaelen's role as a broker seems so specific?\"\n  ]\n}",
