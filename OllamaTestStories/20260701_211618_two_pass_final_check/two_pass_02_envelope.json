  "response": "{\"campaign_title\": \"Iron Scarcity\",\n  \"campaign_subtitle\": \"The Weight of Survival\",\n  \"campaign_logline\": \"A desperate pilot navigates the crumbling infrastructure of a resource-starved sector.\",\n  \"campaign_pitch\": \"You are a debt-ridden independent pilot. Zenith and Aurelia fight over dwindling mineral veins. You take local contracts to survive. A supply chain collapse threatens regional stability.\",\n  \"campaign_story_summary\": \"A struggling pilot takes on Kaelen's first contract. You intercept a Reaver ship carrying critical fuel cells. This sparks tension between the mining giants and the security firm. You find evidence of sabotaged trade routes. The local economy is failing due to intentional supply chain blockades. You must decide which faction's interests to prioritize. Act 1 focuses on securing your own operational independence.\",\n  \"tone\": \"Dry, gritty industrial humor.\",\n  \"opening\": {\n    \"status_quo\": \"The sector is a graveyard of industrial decay and heavy metal scarcity.\",\n    \"visible_crisis\": \"Mining rights are being contested by three rival factions.\",\n    \"hidden_crisis\": \"A deliberate sabotage campaign is crippling the regional supply chain.\",\n    \"why_now\": \"Fuel reserves are critically low, forcing desperate measures from all parties.\",\n    \"player_role\": \"You are an independent contractor with a failing ship.\"\n  },\n  \"mystery\": {\n    \"question\": \"Who is sabotaging the trade routes?\",\n    \"false_answer\": \"A rogue group of pirates and smugglers.\",\n    \"true_answer_hint\": \"An internal corporate liquidation strategy to force consolidation.\",\n    \"long_term_reveal_direction\": \"The truth will be revealed through intercepted logistics logs.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker, fixer, and contract handler.\",\n    \"secret_angle\": \"She tracks the flow of high-grade fuel cells specifically.\",\n    \"address_rule\": \"Refer to her as a broker or fix_er.\",\n    \"never_reveal_rule\": \"Her motives for tracking these specific assets are hidden.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith struggles with declining ore yields and failing infrastructure.\",\n    \"aurelia_problem\": \"Aurelia faces a shortage of high-grade fuel cells.\",\n    \"vanguard_problem\": \"Vanguard is losing its grip on the security perimeter.\",\n    \"conflict_triangle\": \"All three factions are fighting over the same dwindling resources.\",\n    \"neutral_space_pressure\": \"Independent pilots are forced into choosing sides or facing fines.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Scarcity Loop\",\n    \"goal\": \"Secure enough fuel and parts to keep your ship operational.\",\n    \"opening_itement\": \"You intercept a Reaver ship carrying stolen high-grade fuel cells.\",\n    \"midpoint_turn\": \"Kaelen offers you a choice between two different delivery routes.\",\n    \"finale\": \"You establish a trade route that secures your own independence.\",\n    \"player_takeaway\": \"Survival requires navigating the politics of resource scarcity.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"The Reaver's Cargo\",\n    \"reason\": \"You need to secure high-grade fuel cells for your ship.\",\n    \"enemy_identity\": \"A single, damaged Reaver ship.\",\n    \"enemy_knows\": \"It is unaware of your presence until you initiate contact.\",\n    \"after_effect\": \"You gain a few units of high-grade fuel and some scrap.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"The Ghost Route\",\n     \"signal\": \"A series of encrypted logs showing diverted cargo paths.\",\n    \"first_appearance\": \"Found in the data core of the Reaver ship.\",\n    \"escalation\": \"More routes are found to be intentionally redirected toward a dead zone.\",\n    \"payoff_hint\": \"The hidden route leads to an abandoned processing hub.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"Shortage of Heavy Metals\",\n    \"trail_id\": \"rumor_trail.heavy_metal_shortage\",\n    \"hint_theme\": \"Reports of missing cargo and empty warehouses.\",\n    \"clue_templates\": [\"The local hub has no more high-grade fuel cells.\", \"A smuggler told me the heavy metals are moving elsewhere.\"],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"local\",\n    \"payoff\": \"Unlocks a secret trade route with higher profit margins.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The next gate leads to a system where the supply lines are intact.\",\n    \"new_system_reveal_rule\": \"New systems will be revealed as you reach the edge of sphere.\",\n    \"future_pressure_tease\": \"Rumors suggest a larger corporation is watching from the outer rim.\",\n    \"future_ore_or_upgrade_tease\": \"The next system has high-grade fuel cells in abundance.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regen_supply_chain_logic\",\n      \"metric\": \"prepared_systems_remaining\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the current system's supply chain is fully explored.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Dry, slightly dark humor.\",\n    \"fallback\": \"If a contract is failed, the broker will offer another.\",\n    \"banned_repeats\": [\"chosen one\", \"destiny\", \"ghost signal\", \"echoes of the void\", \"mysterious pulse\"]\n  },\n  \"story_questions_for_future_thought_generation\": [\n    \"What are the ways the local trade hub offers different prices for cargo weight?\",\n    \"Why do some delivery routes be more dangerous and offer higher rewards?\",\n    \"How many ways can you sabotage a rival's supply line?\",\n    \"Who holds the monopoly over high-grade fuel cells?\",\n    \"Which of the following options provides a couple of different paths forward?\"\n  ]\n}",
