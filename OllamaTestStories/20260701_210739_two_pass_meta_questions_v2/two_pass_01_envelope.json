  "model": "gemma4:12b",
  "created_at": "2026-07-02T01:08:21.1781385Z",
  "response": "{\"campaign_title\": \"Rust and Revenue\",\n  \"campaign_subtitle\": \"The Scarcity of the Rim\",\n  \"campaign_logline\": \"A debt-ridden pilot navigates a decaying industrial sector where trade is survival.\",\n  \"campaign_pitch\": \"Scavenge parts from derelicts. Navigate corporate tensions. Survive the heavy costs of space travel.\",\n  \"campaign_story_summary\": \"The Aurelia corporation owns the primary refining routes. Zenith provides high-end logistics and security. Vanguard seeks freedom through decentralized trade. You are a pilot trying to pay off your ship's lease. Each delivery is a step toward independence from corporate masters. Every scrap of metal counts in this dying sector.\",\n  \"tone\": \"Dry, gritty industrial humor.\",\n  \"opening\": {\n    \"status_quo\": \"The local trade routes are crumbling under high maintenance costs.\",\n    \"visible_crisis\": \"Resource shortages have forced corporations to tighten their grip on supply lines.\",\n    \"hidden_crisis\": \"A systemic infrastructure collapse is making independent operations nearly impossible.\",\n    \"why_now\": \"A major refinery has failed, creating a sudden demand for local scrap and parts.\",\n    \"player_role\": \"You are an independent pilot with mounting debts and a failing ship.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why is the brokerage system favoring specific corporations?\",\n    \"false_answer\": \"The system is designed to prioritize high-priority corporate contracts.\",\n    \"true_answer_hint\": \"The brokers are intentionally starving out smaller independent operators.\",\n    \"long_term_reveal_direction\": \"The infrastructure collapse is being orchestrated by a central oversight body.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker, fixer, and contract handler.\",\n    \"secret_angle\": \"She manages the flow of information between competing factions.\",\n    \"address_rule\": \"Address her as a professional contact for logistics and repairs.\",\n    \"never_reveal_rule\": \"Never reveal her true role in the data-brokerage network.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith faces high costs to maintain their premium infrastructure.\",\n    \"aurelia_problem\": \"Aurelia struggles to secure raw materials from independent sources.\",\n    \"vanguard_problem\": \"Vanguard is struggling to find reliable transport for their decentralized network.\",\n    \"conflict_triangle\": \"The three factions fight over the remaining viable trade routes.\",\n    \"neutral_space_pressure\": \"Independent pilots are being squeezed by increasing corporate taxes.\"\n  },\n  \"act_1\": {\n    \"name\": \"Scrap and Salvage\",\n    \"goal\": \"Secure enough parts to keep your ship operational for one month.\",\n    \"opening_itement\": \"A Reaver scout ship is intercepted near a derelict refinery.\",\n    \"midpoint_turn\": \"You find high-value components in the wreckage of an old transport.\",\n    \"finale\": \"You successfully deliver a critical component to a local hub.\",\n    \"player_takeaway\": \"Survival requires navigating the politics of scrap and parts.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"The Scraped Hull\",\n    \"reason\": \"A Reaver ship is encroaching on a local trade lane.\",\n    \"enemy_identity\": \"Reaver Scavenger Ship\",\n    \"enemy_knows\": \"It is hunting for scrap in the same zone as you.\",\n    \"after_effect\": \"You gain access to a list of high-value salvage targets.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"The Ghost Circuit\",\n    \"signal\": \"A repeating pattern of data packets lost during transit.\",\n    \"first_appearance\": \"Found in the logs of a derelict refinery ship.\",\n    \"escalation\": \"More ships are reporting missing data packets in trade zones.\",\n    \"payoff_hint\": \"The circuit is part of an old, hidden communication network.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Black Market Route\",\n    \"trail_id\": \"rumor_trail.black_market_route\",\n    \"hint_theme\": \"Illegal trade routes and off-grid data.\",\n    \"clue_templates\": [\"A local smuggler mentions a shortcut through the Asteroid Belt.\", \"A broken radio signal from an unregistered ship.\"],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"rare\",\n    \"payoff\": \"Access to a hidden, high-value trade route.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"A stable gate leads toward the northern industrial sector.\",\n    \"new_system_reveal_rule\": \"New systems are revealed as you reach the edge of known territory.\",\n    \"future_pressure_tease\": \"The demand for cargo and scrap will increase in the next zone.\",\n    \"future_ore_or_upgrade_tease\": \"Higher-grade minerals can be found in the outer rim sectors.\",\n    \"regeneration_trigger\": {\n      \"id\": \"system_regen_trigger\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the main arc is complete, new story beats are added.\"\n    }\n  },\n  \"rules\": {\n    \"humor__rule\": \"Dry, slightly dark humor.\",\n    \"fallback\": \"If a contract fails, you must pay for repairs and fuel.\",\n    \"banned_repeats\": [\"chosen one\", \"destiny\", \"ghost signal\", \"echoes of the void\", \"mysterious pulse\"]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What will be the next major threat to trade routes?\",\n    \"Why are the core factions' demands more urgent and frequent?\",\n    \"How does the player's reputation with Vanguard impact their future options?\",\n    \"Who is the primary authority over the sector's infrastructure? \",\n    \"Which path leads to the most significant change in power balance?\"\n  ]\n}",
