  "model": "gemma4:12b",
  "created_at": "2026-07-02T01:09:03.5615234Z",
  "response": "{\"campaign_title\": \"Iron Scarcity\",\n  \"campaign_subtitle\": \"The Rust of the Trade Routes\",\n  \"campaign_logline\": \"A desperate pilot navigates a crumbling trade network where every scrap of metal is worth its weight in gold.\",\n  \"campaign_pitch\": \"Trade routes are failing. Resources are dwindling. You must navigate the decay to survive.\",\n  \"campaign_story_summary\": \"The local economy relies on aging infrastructure. Zenith seeks to monopolize the core lanes. Aurelia focuses on heavy extraction and production. Vanguard maintains the security of the supply chain. Independent pilots struggle to stay solvent. A critical shortage of high-grade alloys is crippling trade. You must decide who to support during the collapse.\",\n  \"tone\": \"Dry, slightly dark frontier humor.\",\n  \"opening\": {\n    \"status_quo\": \"The sector's infrastructure is crumbling under heavy use.\",\n    \"visible_crisis\": \"Trade routes are becoming increasingly hazardous and expensive.\",\n    \"hidden_crisis\": \"A critical shortage of high-grade alloys is causing a secret supply chain collapse.\",\n    \"why_now\": \"Contract demands have spiked as the primary refinery hub is failing.\",\n    \"player_role\": \"You are an independent pilot seeking to stay afloat.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why is there no replacement for high-guard alloy?\",\n    \"false_answer\": \"The material is extremely rare and hard to mine.\",\n    \"true_answer_hint\": \"The supply chain was intentionally sabotaged by a shadow corporation.\",\n    \"long_term_reveal_direction\": \"Investigate the origins of the manufacturing contracts.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker and contract handler.\",\n    \"secret_angle\": \"She is tracking the flow of high-guard alloy to identify its source.\",\n    \"address_rule\": \"Refer to her as a broker or fixer.\",\n    \"never_reveal_rule\": \"Never reveal her true motive for hiring you.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith wants to monopolize the trade lanes by imposing heavy tolls.\",\n    \"aurelia_problem\": \"Aurelia is struggling to maintain their extraction equipment with failing parts.\",\n    \"v_problem\": \"Vanguard's patrol zones are becoming increasingly aggressive and unpredictable.\",\n    \"conflict_triangle\": \"Zenith wants control, Aurelia needs resources, Vanguard enforces the law.\",\n    \"neutral_space_pressure\": \"Independent pilots are being squeezed out of the market by corporate greed.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Scarcity Hunt\",\n    \"goal\": \"Secure a steady supply of high-guard alloy for local trade.\",\n    \"opening_incident\": \"A shipment of scrap metal is intercepted by a pirate ship.\",\n    \"midpoint_turn\": \"You discover that the scrap is actually high-grade industrial components.\",\n    \"finale\": \"You deliver a critical component to an Aurelia refinery.\",\n    \"player_takeaway\": \"You learn that some contracts are more complex than they seem.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"The Scrap Haul\",\n    \"reason\": \"A scavenger ship is trying to claim the scrap before you do.\",\n    \"enemy_identity\": \"A lone Reaver-class vessel.\",\n    \"enemy_knows\": \"It thinks it is just another desperate scavenger.\",\n    \"after_effect\": \"You gain a small amount of high-grade alloy and some local reputation.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"The Ghost Line\",\n    \"signal\": \"A recurring pattern in the trade logs.\",\n    \"first_appearance\": \"Mentioned during a contract briefing with Kaelen.\",\n    \"escalation\": \"More contracts involving high-guard alloy appear more frequently.\",\n    \"payoff_hint\": \"The log patterns suggest an intentional, systematic sabotage.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Smuggler's Path\",\n    \"trail_id\": \"rumor_trail.smuggler_path\",\n    \"hint_theme\": \"Hidden routes and illegal scrap collection.\",\n    \"clue_templates\": [\n      \"A smuggler told me the old routes are safer than the new ones.\",\n      \"The shadow trade is moves more metal than the official channels.\"\n    ],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"uncommon\",\n    \"payoff\": \"Unlocks a secret route to a nearby refinery hub.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The next gate leads toward the heart of the manufacturing core.\",\n    \"new_system_reveal_rule\": \"New systems are revealed as you reach the edge of known trade routes.\",\n    \"future_pressure_tease\": \"Reports of escalating tensions between Zenith and Aurelia's supply chain.\",\n    \"future_ore_or_upgrade_tease\": \"Rumors of high-grade alloys being used in advanced ship components.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regen_scarcity_hunt\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_arc\",\n      \"description\": \"When the first act ends, add a new story arc about the supply chain collapse.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Use dry, slightly dark frontier humor.\",\n    \"fallback\": \"If no contract is available, Kaelen's offer will be more desperate and direct.\",\n    \"banned_repeats\": [\n      \"chosen one\",\n      \"destiny\",\n      \"reason_for_tutorial\",\n      \"scarcity_hunt\"\n    ]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What new types of cargo are introduced later?\",\n    \"Why does the market value of resources change over time?\",\n    \"How do different factions offer competing incentives?\",\n    \"Who is the ultimate authority in the sector?\",\n    \"Which trade route is currently under threat?\"\n  ]\n}",
