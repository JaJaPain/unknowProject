  "model": "gemma4:12b",
  "created_at": "2026-07-02T02:31:12.6082487Z",
  "response": "{\n  \"campaign_title\": \"The Scavenger's Ledger\",\n  \"campaign_logline\": \"In the wake of corporate insolvency, scrap is currency. You hunt for lost assets in dead hulls to pay off your growing debt.\",\n  \"opening_situation\": \"You start with a beat-up hauler and a 'Salvage Rights' permit for Zenith. Aurelia and Vanguard are nearby but guarded by heavy picket patrols.\",\n  \"main_mystery\": \"The cargo logs of the derelict ships in the first system contain patterns suggesting systematic insurance fraud on a massive scale.\",\n  \"act_1_outline\": [\n    \"Recover basic scrap from local wrecks to clear initial docking fees and fines.\",\n    \"Identify high-value 'ghost' manifests in Aurelia's outskirts that trigger legal notices.\",\n    \"Decipher encrypted distress logs found in ship cores to uncover hidden corporate ownership.\"\n  ],\n  \"long_term_reveal\": \"The insurance fraud was a shell game; the cargo wasn't lost, it was intentionally buried to hide illicit mineral movements.\",\n  \"tone\": \"Dry, cynical, slightly dark.\",\n  \"core_pressure\": \"Debt collection and escalating legal scrutiny from heavy-handed corporate enforcement.\",\n  \"kaelen_rule\": \"Kaelen is a broker/fixer. Her true identity remains hidden; she cannot die or be fully understood by the player.\",\n  \"faction_reveal_rule\": \"New factions, ores, and upgrades are only revealed through gate travel to new systems.\",\n  \"humor_rule\": \"Dry humor about ship maintenance, bureaucracy, and the absurdity of space-law.\",\n  \"address_rule\": \"NPCs address the player as 'Salvager' or 'Contractor'.\",\n  \"fallback_rule\": \"If data is missing, default to procedural lore regarding local orbital mechanics or mineral density.\",\n  \"story_horizon_rule\": \"Trigger if active_story_arcs_remaining is 0. Action: append_story_horizon.\",\n  \"story_arcs\": [\n    {\n      \"name\": \"The Ghost Cargo\",\n      \"summary\": \"Trace a series of mismatched manifests to uncover who was actually stealing the shipments.\"\n    }\n  ],\n  \"rumor_trails\": [\n    {\n      \"name\": \"The Blackbox Paradox\",\n      \"trail_id\": \"rumor_trail.black_box_paradox\",\n      \"clue_count\": 2,\n      \"hint_theme\": \"corrupted data logs\",\n      \"clue_templates\": [\n        \"A corrupted log mentions 'Protocol Void' and an unregistered cargo bay.\",\n        \"An encrypted audio file contains a frantic warning about 'Shipment 99-X'.\"\n      ],\n      \"discovery_type\": \"endgame_easter_egg\",\n      \"rarity\": \"legendary\",\n      \"payoff\": \"Unlocks the 'Ghost Ship' coordinates and a secret stash of untraceable currency.\"\n    }\n  ],\n  \"regeneration_triggers\": [\n    {\n      \"id\": \"exhausted_arcs_trigger\",\n      \"metric\": \"active_story_arcs_remaining\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the current arc concludes, generate a new narrative horizon based on discovered cargo types.\"\n    }\n  ],\n  \"expansion_rules\": [\n    \"Do not retcon player choices; append new content to the existing timeline.\",\n    \"Ensure all newly generated systems feature unique trade goods and local hazards.\"\n  ],\n  \"banned_repeats\": [\n    \"Great Silence\",\n    \"Ghost Signal\",\n    \"Prophecy\",\n    \"Chosen One\"\n  ]\n}",
