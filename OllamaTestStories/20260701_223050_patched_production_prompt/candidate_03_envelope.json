  "model": "gemma4:12b",
  "created_at": "2026-07-02T02:31:54.880149Z",
  "response": "{\n  \"campaign_title\": \"The Silted Vein\",\n  \"campaign_logline\": \"Asteroid mining in the Aurelia sector has unearthed a reactive, caustic sludge that is corroding hulls and poisoning local oxygen supplies.\",\n  \"opening_situation\": \"Your ship is docked at a Zenith refinery. The air smells of copper and sulfur. A panicked foreman offers a high-pay contract to clear 'clogged' pipes in the lower shafts.\",\n  \"main_mystery\": \"The toxic sludge isn't a natural byproduct; it is a deliberate industrial waste spill being hidden as an accidental seepage.\",\n  \"act_1_outline\": [\n    \"Identify and clear localized blockages in the Aurelia mining hub.\",\n    \"Investigate reports of 'phantom leaks' occurring only during high-output shifts.\",\n    \"Recover encrypted logs from a derelict transport ship near the Vanguard zone.\"\n  ],\n  \"long_term_reveal\": \"The sludge is byproduct from illegal refining of prohibited isotopes, laundered through shell companies and masked as environmental accidents.\",\n  \"tone\": \"Dry, gritty, industrial-gothic with cynical corporate satire.\",\n  \"core_pressure\": \"Degrading hull integrity and oxygen scarcity caused by corrosive particulates.\",\n  \"kaelen_rule\": \"Kaelen is publicly a contract handler; she never reveals her true nature or identity.\",\n  \"faction_reveal_rule\": \"Only reveal new factions, ores, and ships accessible through jump gates to new systems.\",\n  \"humor_rule\": \"Dry, dark humor regarding corporate bureaucracy and the absurdity of working in hazardous zones.\",\n  \"address_rule\": \"NPCs address the player as 'Pilot' or 'Contractor'.\",\n  \"fallback_rule\": \"If content is missing, default to environmental storytelling about local industrial decay.\",\n  \"story_horizon_rule\": \"When active_story_arcs_remaining falls below 2, trigger append_story_horizon.\",\n  \"story_arcs\": [\n    {\n      \"name\": \"The Corrosive Pipeline\",\n      \"summary\": \"Trace the source of the acid leaks from local mines to a central processing hub used by shadow entities.\"\n    }\n  ],\n  \"rumor_trails\": [\n    {\n      \"name\": \"Ghost in the Pipes\",\n      \"trail_id\": \"rumor_trail.ghost_pipes\",\n      \"clue_count\": 2,\n      \"hint_theme\": \"Corrupted telemetry logs\",\n      \"clue_templates\": [\n        \"A frequency-scrambled log mentioning 'Project Midas'.\",\n        \"An encrypted manifest for 'non-reactive' industrial chemicals.\"\n      ],\n      \"discovery_type\": \"faction_secret\",\n      \"rarity\": \"rare\",\n      \"payoff\": \"Unlocks a hidden faction: The Purifiers, who oppose the current corporate oversight.\"\n    }\n  ],\n  \"regeneration_triggers\": [\n    {\n      \"id\": \"arc_exhaustion_check\",\n      \"metric\": \"active_story_arcs_remaining\",\n      \"threshold\": 2,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"Add new sector content when the current plot arc is completed.\"\n    }\n  ],\n  \"expansion_rules\": [\n    \"Do not reveal future frontier factions in the opening system.\",\n    \"Never retcon player choices; add new branches based on previous outcomes.\"\n  ],\n  \"banned_repeats\": [\n    \"Great Silence\",\n    \"purge protocol\",\n    \"ancient signal\",\n    \"chosen one\",\n    \"fate of the universe\"\n  ]\n}",
