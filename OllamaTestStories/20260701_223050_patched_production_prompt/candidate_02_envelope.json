  "model": "gemma4:12b",
  "created_at": "2026-07-02T02:31:34.0332547Z",
  "response": "{\n  \"campaign_title\": \"The Yield of Zenith\",\n  \"campaign_logline\": \"In the Aurelia sector, your ship isn't yours; it is a leased asset in a system governed by debt-cycles and privatized air.\",\n  \"opening_situation\": \"Player starts with a high-interest lien on their vessel. To keep flight privileges, they must accept contracts from Vanguard security to clear 'delinquent' cargo in the Zenith zone.\",\n  \"main_mystery\": \"The truth behind why Aurelia\u2019s infrastructure is owned by a shadowy consortium and who actually owns the 'debt' of the citizens.\",\n  \"act_1_outline\": [\n    \"Negotiate with Vanguard to settle initial docking fees.\",\n    \"Recover stolen luxury components from pirate-held outposts.\",\n    \"Uncover the discrepancy between local law and corporate ownership.\"\n  ],\n  \"long_term_reveal\": \"The 'Debt' is a curated loop: some sectors are intentionally foreclosed to consolidate resources for a select group of elite shareholders.\",\n  \"tone\": \"Gritty, cynical, dryly humorous, industrial.\",\n  \"core_pressure\": \"Resource Scarcity and Debt Accumulation.\",\n  \"kaelen_rule\": \"Kaelen is publicly a broker; she manages contracts and settles debt disputes.\",\n  \"faction_reveal_rule\": \"New factions are only revealed upon passing through jump gates to adjacent systems.\",\n  \"humor_rule\": \"Dry, dark humor. No catchphrases or repeated jokes about 'space' tropes.\",\n  \"address_rule\": \"NPCs address the player as 'Pilot', 'Contractor', or by their ship's registration ID.\",\n  \"fallback_rule\": \"If data is missing, NPCs default to standard logistical updates regarding cargo and fuel costs.\",\n  \"story_horizon_rule\": \"If active_story_arcs_remaining falls below 2, append_story_arc.\",\n  \"story_arcs\": [\n    {\n      \"name\": \"The Foreclosure Path\",\n      \"summary\": \"Investigate the legal loophole allowing Vanguard to seize ships from 'non-compliant' pilots in the Aurelia sector.\"\n    }\n  ],\n  \"rumor_trails\": [\n    {\n      \"name\": \"Ghost Ledger\",\n      \"trail_id\": \"rumor_trail.ghost_ledger\",\n      \"clue_count\": 2,\n      \"hint_theme\": \"Accounting Discrepancies\",\n      \"clue_templates\": [\n        \"A recurring 'Admin Fee' that doesn't appear on the public manifest.\",\n        \"An encrypted log of a shipment that was never legally registered.\"\n      ],\n      \"discovery_type\": \"endgame_easter_egg\",\n      \"rarity\": \"legendary\",\n      \"payoff\": \"Unlocks the 'Owner's Override' title and a unique hidden system core.\"\n    }\n  ],\n  \"regeneration_triggers\": [\n    {\n      \"id\": \"arc_depletion_trigger\",\n      \"metric\": \"active_story_arcs_remaining\",\n      \"threshold\": 1,\n      \"action\": \"append_story_arc\",\n      \"description\": \"Generate a new arc when the player completes the main primary narrative thread.\"\n    }\n  ],\n  \"expansion_rules\": [\n    \"No retconning of past choices; append new content to existing timelines.\",\n    \"New minerals and ship upgrades must appear only in newly accessible sectors.\"\n  ],\n  \"banned_repeats\": [\n    \"Great Silence\",\n    \"Purge Protocol\",\n    \"Chosen One\",\n    \"Ancient Signal\"\n  ]\n}",
