  "response": "{\"campaign_title\": \"Ironclad Logistics\",\n  \"campaign_subtitle\": \"The Weight of the Chain\",\n  \"campaign_logline\": \"A broken supply chain forces a desperate pilot to navigate the crumbling infrastructure of the inner rim.\",\n  \"campaign_pitch\": \"You are a debt-ridden independent pilot. Zenith and Aurelia clash over critical mineral rights. You haul cargo through decaying orbital zones. A systemic logistical collapse threatens local stability.\",\n  \"campaign_story_summary\": \"You start as an independent pilot in the scrap-heavy belt. Kaelen acts as your primary fixer for illicit contracts. You intercept a Reaver ship carrying high-priority industrial components. Zenith demands expansion while Aurelia seeks isolationist security. You find recurring data logs from a defunct mining corporation. The infrastructure is failing due to over-taxed logistics chains. Act One focuses on securing local supply lines.\",\n  \"tone\": \"Dry, cynical humor regarding the costs of corporate bureaucracy and decaying machinery.\",\n  \"opening\": {\n    \"status_quo\": \"The orbital ring serves as a crumbling hub for mineral extraction.\",\n    \"visible_crisis\": \"Supply chains are failing due to aging infrastructure and high maintenance costs.\",\n    \"hidden_crisis\": \"A private corporation owns the rights to life support systems across the sector.\",\n    \"why_now\": \"Recent shortages in essential components have forced local trade into dangerous zones.\",\n    \"player_role\": \"You are a freelance pilot with a failing ship and mounting debts.\"\n  },\n  \"mystery\": {\n    \"question\": \"Who owns the rights to life support systems?\",\n    \"false__answer\": \"The government has abandoned the system for lack of funds.\",\n    \"true_answer_hint\": \"A private corporation holds a monopoly on atmospheric and oxygen production.\",\n    \"long_term_reveal_direction\": \"The core infrastructure is being intentionally dismantled to favor high-end corporate clients.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Kaelen is a broker and contract handler for the local trade routes.\",\n    \"secret_angle\": \"She maintains an independent network of data logs from defunct corporations.\",\n    \"address_rule\": \"Refer to her as Kaelen or The Broker.\",\n    \"never_reveal_rule\": \"Never reveal her origin, her specific affiliations, or how she manages the data.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith seeks aggressive expansion into deep-space mining zones.\",\n    \"aurelia_problem\": \"Aurelia demands isolationist security and high import costs for tech.\",\n    \"vanguard_problem\": \"Vanguard protects militarized trade routes with heavy enforcement.\",\n    \"conflict_triangle\": \"The three factions fight over the remaining viable mineral deposits.\",\n    \"neutral_space_pressure\": \"Scavengers and pirates thrive where official oversight is absent.\"\n  },\n  \"act_1\": {\n    \"name\": \"Fractured Chains\",\n    \"goal\": \"Secure enough cargo to pay off your initial debts.\",\n    \"opening_incident\": \"You intercept a Reaver ship carrying high- priority industrial components.\",\n    \"midpoint_turn\": \"You discover that the cargo is part of a critical infrastructure project.\",\n    \"finale\": \"You establish a reliable trade route between Zenith and Aurelia zones.\",\n    \"player_takeaway\": \"You realize that every piece of hardware you carry has a corporate owner.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"The Broken Link\",\n    \"reason\": \"A Reaver ship is transporting high-priority industrial components in an unlicensed zone.\",\n    \"enemy_identity\": \"A lone Reaver vessel with an active tracking beacon.\",\n    \"enemy_knows\": \"The Reaver knows its cargo is valuable and will defend it aggressively.\",\n    \"after_effect\": \"You find a manifest showing the cargo belongs to a defunct corporation.\"\n  },\n  \"recurring_l_clue\": {\n    \"name\": \"Corporate Ledger Logs\",\n    \"signal\": \"A recurring encrypted packet of industrial data.\",\n    \"first_appearance\": \"Found in the Reaver ship's log files after the first mission.\",\n    \"escalation\": \"More logs appear as you visit different mining stations.\",\n    \"payoff_hint\": \"The logs reveal a pattern of systematic infrastructure dismantling.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Ghost in the Pipeline\",\n    \"trail_id\": \"rumor_trail.ghost_in_pipeline\",\n    \"hint_theme\": \"Rumors of automated systems still running on old contracts.\",\n    \"clue_templates\": [\n      \"A technician claims a drone is still delivering to an empty station.\",\n      \"A smuggler says a piece of tech has a tracking beacon that won't turn off.\"\n    ],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"rare\",\n    \"payoff\": \"You find a hidden cache of industrial tools and high-grade parts.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The next gate leads to systems where the infrastructure is even more decayed.\",\n    \"new_system_reveal_rule\": \"Do not reveal names or specific identities of future factions.\",\n    \"future_pressure_tease\": \"Reports suggest that trade routes are becoming increasingly unstable and dangerous.\",\n    \"future_ore_or_upgrade_tease\": \"Advanced components are only available in the outskirts, where safety is sold as a premium.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regen_infrastructure_check\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the first arc is complete, new routes and hazards are added.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Use dry, cynical humor regarding corporate bureaucracy and hardware failure.\",\n    \"fallback\": \"If a quest-line is not available, provide a generic cargo delivery mission.\",\n    \"banned_repeats\": [\n      \"chosen one\",\n      \"destiny\",\n      \"ancient signal\",\n      \"mystered pulse\",\n      \"ghost ship\",\n      \"alien owner\"\n    ]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What is the core infrastructure of the galaxy facing a collapse?\",\n    \"Why do corporate owners have a monopoly on life support systems?\",\n    \"How do different factions and allies compete for resources during this crisis?\",\n    \"Who owns the rights to the rest of universe's technology?\",\n    \"Why is there no longer a single unified government across all systems?\"\n  ]\n}",
