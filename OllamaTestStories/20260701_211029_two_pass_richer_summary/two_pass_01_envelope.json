  "response": "{\"campaign_title\": \"Rust and Rations\",\n  \"campaign_subtitle\": \"The Scarcity of the Outer Rim\",\n  \"campaign_logline\": \"A desperate pilot navigates a dying industrial sector where every scrap of metal is worth its weight in fuel.\",\n  \"campaign_pitch\": \"You are a debt-ridden pilot. Zenith and Aurelia fight over shrinking mineral rights. You haul cargo to survive the week. A massive supply chain collapse threatens local stability.\",\n  \"campaign_story_summary\": \"A struggling pilot takes contracts from Kaelen. A Reaver ship is intercepted near a mining hub. The strike causes a localized fuel shortage. Zenith and Aurelia clash over remaining reserves. You find encrypted logs about manufacturing shortages. A hidden economic rot eats the sector's trade. Act 1 focuses on securing local supply lines.\",\n  \"tone\": \"Dry, cynical, and gritty industrial sci-fi.\",\n  \"opening\": {\n    \"status_quo\": \"The mining hubs are failing due to aging infrastructure.\",\n    \"visible_crisis\": \"Fuel shortages have made transport routes dangerous.\",\n    \"hidden_crisis\": \"A systemic manufacturing collapse is hollowing out the market.\",\n    \"why_now\": \"Current reserves are critically low for the next cycle.\",\n    \"player_role\": \"An independent pilot with a failing ship.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why is the industrial output dropping so sharply?\",\n    \"false_answer\": \"The equipment is simply too old to maintain.\",\n    \"true_answer_hint\": \"Manufacturing hubs are being intentionally sabotaged by a shadow entity.\",\n    \"long_term_reveal_direction\": \"The sabotage is part of a larger corporate dismantling plan.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker and contract handler.\",\n    \"secret_angle\": \"She tracks the flow of essential resources to predict market crashes.\",\n    \"address_rule\": \"Always refer to her as Kaelen.\",\n    \"never_reveal_rule\": \"Her origin or true motives remain unknown.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith demands priority for industrial manufacturing components.\",\n    \"aurelia_problem\": \"Aurelia insists on stabilizing orbital trade routes.\",\n    \"vanguard_problem\": \"Vanguard faces constant supply line disruptions.\",\n    \"conflict_triangle\": \"Resource scarcity forces three factions to corner the market.\",\n    \"neutral_space_pressure\": \"Independent traders are squeezed by rising fuel costs.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Scarcity Cycle\",\n    \"goal\": \"Secure enough parts for a local refinery.\",\n    \"opening_incident\": \"A Reaver ship is intercepted near the main gate.\",\n    \"midpoint_turn\": \"You discover that the haul was stolen from Aurelia.\",\n    \"finale\": \"The local refinery is stabilized by your delivery.\",\n    \"player_takeaway\": \"Survival depends on choosing which faction's cargo is prioritized.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"Scrap of the Scarcity\",\n    \"reason\": \"A Reaver ship carrying vital fuel components must be neutralized.\",\n    \"enemy_identity\": \"A single, damaged Reaver vessel.\",\n    \"enemy_knows\": \"The Reaver is desperate for scrap and will fight aggressively.\",\n    \"after_effect\": \"You recover the cargo and receive your first payment.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"The Shortage Log\",\n    \"signal\": \"Encrypted data packets in derelict hulls.\",\n    \"first_appearance\": \"Found inside the Reaver ship's core.\",\n    \"escalation\": \"More logs appear as you visit more mining hubs.\",\n    \"payoff_hint\": \"The logs reveal a pattern of intentional sabotage.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Ghost Refinery\",\n    \"trail_id\": \"rumor_trail.ghost_refinery\",\n    \"hint_theme\": \"Abandoned industrial sites and illegal trade.\",\n    \"clue_templates\": [\n      \"A rumor of a hidden refinery is circulating among miners.\",\n      \"Some pilots say the scrap metal is being diverted to an unknown location.\"\n    ],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"rare\",\n    \"payoff\": \"Unlocks a secret route to a high-value salvage site.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The next gate leads toward the manufacturing heartlands.\",\n    \"new_system_reveal_rule\": \"New systems are revealed only when a gate is successfully navigated.\",\n    \"future_pressure_tease\": \"Rumors of an encroaching trade blockade.\",\n    \"future_ore_or_upgrade_tease\": \"Advanced alloys and heavy-duty engine upgrades.\",\n    \"regeneration_trigger\": {\n      \"id\": \"refinery_stabilization_trigger\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the refinery is stabilized, new trade routes are revealed.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Use dry, cynical humor regarding ship maintenance and fuel costs.\",\n    \"fallback\": \"If a quest objective is unclear, default to a contract from Kaelen.\",\n    \"banned_repeats\": [\n      \"chosen one\",\n      \"destiny\",\n      \"ancient signal\",\n      \"ghost signal\",\n      \"mystery_ous pulse\",\n      \"alien owner\"\n    ]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What is the scale of the rest of universe?\",\n    \"Why is there no central government?\",\n    \"How does a new faction emerge from the collapse?\",\n    \"Who will be told to abandon their ship first?\",\n    \"Where can the player find a relic of pre-spaceflight?\"\n  ]\n}",
