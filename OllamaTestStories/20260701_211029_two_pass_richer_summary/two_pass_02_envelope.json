  "created_at": "2026-07-02T01:11:56.3385695Z",
  "response": "{\"campaign_title\": \"Rust and Refinement\",\n  \"campaign_subtitle\": \"The Scarcity of the Outer Rim\",\n  \"campaign_logline\": \"A struggling pilot navigates a crumbling trade network where every scrap of metal counts.\",\n  \"campaign_pitch\": \"You are a debt-ridden independent pilot. The three main factions fight over dwindling resources. You take contracts from Kaelen to survive. A growing shortage of refined materials threatens the sector's stability.\",\n  \"campaign_story_summary\": \"A broke pilot takes local contracts to stay afloat. Kaelen acts as your primary broker and fixer. You intercept a Reaver ship whose cargo is being guarded by automated systems. This incident draws attention from Zenith, Aurelia, and Vanguard. A recurring mention of 'The Filtered Zone' appears in logs. The sector faces a severe shortage of high-grade oxygen filters. Act 1 focuses on establishing your reputation through salvage and delivery.\",\n  \"tone\": \"Dry, gritty industrial atmosphere with weary humor.\",\n  \"opening\": {\n    \"status_quo\": \"Trade routes are failing due to aging infrastructure and fuel scarcity.\",\n    \"visible_crisis\": \"The local economy is collapsing as high-grade oxygen filters become rare.\",\n    \"hidden_crisis\": \"A logistics chain for essential components has been intentionally severed.\",\n    \"why_now\": \"Recent pirate activity has forced the factions into a desperate, aggressive stance.\",\n    \"player_role\": \"You are an independent pilot with a failing ship and mounting debts.\"\n  },\n  \"mystery\": {\n    \"question\": \"Who is sabotaging the supply chain of essential components?\",\n    \"false_answer\": \"A rival mining corporation is hoarding materials for their own use.\",\n    \"true_answer_hint\": \"The sabotage is a calculated move to force local populations into dependency.\",\n    \"long_term_reveal_direction\": \"The scope of the blockade will be revealed in later sectors.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker, fixer, and contract handler.\",\n    \"secret_angle\": \"She knows exactly who is manipulating the supply chains.\",\n    \"address_rule\": \"Refer to her as Kaelen or 'The Broker'.\",\n    \"never_reveal_rule\": \"Her true identity and motives are never fully revealed.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith seeks to monopolize the remaining high-grade oxygen filters.\",\n    \"aurelia_problem\": \"Aurelia prioritizes orbital scrap collection over raw mineral extraction.\",\n    \"vanguard_problem\": \"Vanguard is pushing into contested territory to secure fuel sources.\",\n    \"conflict_triangle\": \"The three factions are fighting for control of the dwindling supply lines.\",\n    \"neutral_space_pressure\": \"Pirates and scavengers thrive in the lawless gaps between faction zones.\"\n  },\n  \"act_1\": {\n    \"name\": \"Scrap and Survival\",\n    \"goal\": \"Establish a reputation while securing enough parts to keep your ship running.\",\n    \"opening_incident\": \"You intercept an automated Reaver ship carrying high- demand components.\",\n    \"midpoint_turn\": \"A shipment of filters is found in a derelict hull, sparking interest from all three factions.\",\n    \"finale\": \"You successfully deliver the cargo and gain recognition as a reliable contractor.\",\n  \"player_takeaway\": \"The player learns that survival in the rim depends on knowing who to trade with.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"The Reaver's Cargo\",\n    \"reason\": \"You need to secure your next contract and clear a debt.\",\n    \"enemy_identity\": \"A lone, automated Reaver ship.\",\n    \"enemy_knows\": \"The Reaver is unaware of your presence until it enters your range.\",\n    \"after_effect\": \"You gain experience and a small cache of high-demand components.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"The Filtered Zone\",\n    \"signal\": \"A recurring mention of 'The Filtered Zone' in local logs.\",\n    \"first_appearance\": \"Found within the data logs of a Reaver ship.\",\n    \"escalation\": \"Mentioned more frequently as you approach the outer rim.\",\n    \"payoff_hint\": \"Points toward a hidden infrastructure project.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Ghost of the Forge\",\n    \"trail_id\": \"rumor_trail.ghost_of_the_forge\",\n    \"hint_theme\": \"Old industrial machinery and abandoned factories.\",\n    \"clue_templates\": [\n      \"A rumor says a hidden factory is still running in the dead zone.\",\n      \"A whisper of an old forge where parts are made.\"\n    ],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"rare\",\n    \"payoff\": \"Discovery of a hidden, high-capacity production site for spare parts.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The next gate leads toward the more desolate and industrial zones.\",\n    \"new_system_reveal_rule\": \"New systems are revealed only as you reach the nearest gate.\",\n    \"future_pressure_tease\": \"Reports of a growing shortage of high-grade oxygen filters in neighboring sectors.\",\n    \"future_ore_or_upgrade_tease\": \"Rumors of superior, older-generation hardware from deeper space.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regen_scarcity_trigger\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the main arc is complete, new story elements are added.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Dry and slightly dark humor about space-faring hardware.\",\n    \"fallback\": \"If a contract fails, Kaelen provides a replacement task.\",\n    \"banned_repeats\": [\n      \"chosen one\",\n      \"destiny\",\n      \"",
