  "response": "{\"campaign_title\": \"Edge of the Void\",\n  \"campaign_subtitle\": \"The Scarcity Protocol\",\n  \"campaign_logline\": \"A desperate pilot navigates a tightening grip on trade routes and dwindling resources.\",\n  \"campaign_pitch\": \"Resources are thinning in the outer rim. You must navigate the competing interests of three major powers while keeping your ship intact.\",\n  \"campaign_story_summary\": \"The Zenith Corporation finds its supply lines choked. Aurelia seeks to secure independent mining zones. The Vanguard protects the trade routes from pirates. You find work with Kaelen to survive.\",\n  \"tone\": \"Dry, gritty frontier humor.\",\n  \"opening\": {\n    \"status_quo\": \"Trade routes are stable but increasingly expensive.\",\n    \"visible_crisis\": \"Pirates and scavengers are raiding cargo ships.\",\n    \"hidden_crisis\": \"The core systems are experiencing a critical shortage of refined minerals.\",\n    \"why_now\": \"A major mining hub has just collapsed, forcing local trade into the open.\",\n    \"player_role\": \"An independent pilot seeking to pay off ship debts.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why is there a sudden surge in illegal mineral refining?\",\n    \"false_answer\": \"A rogue mining guild is trying to corner the market.\",\n    \"true_answer_hint\": \"The core systems are secretly manufacturing for an unknown, distant purpose.\",\n    \"long_term_reveal_direction\": \"The true scale of infrastructure projects in the deep core.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker and contract handler.\",\n    \"secret_angle\": \"She knows exactly who is ordering the illegal refining.\",\n    \"address_rule\": \"Refer to her as a broker or fixer.\",\n    \"never_reveal_rule\": \"Never reveal her role as a gate scientist or official liaison.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith is struggling with the high cost of logistics.\",\n    \"aurelia_problem\": \"Aurelia wants to establish permanent mining outposts.\",\n    \"vanguard_problem\": \"The Vanguard is overstretched and losing control of patrols.\",\n    \"conflict_triangle\": \"All three factions are fighting for the same dwindling mineral deposits.\",\n    \"neutral_space_pressure\": \"Pirates are moving into the gaps left by official patrols.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Scarcity Hunt\",\n    \"goal\": \"Secure enough contracts to establish a stable base of operations.\",\n    \"opening_incident\": \"A shipment of refined minerals is intercepted and stolen.\",\n    \"midpoint_turn\": \"You find evidence that the theft was planned by an internal source.\",\n    \"finale\": \"You deliver a successful haul and earn your first major contract.\",\n    \"player_takeaway\": \"The market is tightening, and you need to be careful.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"Scavenger's Toll\",\n    \"reason\": \"A pirate ship was caught in a gravity well during an illegal haul.\",\n    \"enemy_identity\": \"Reaver-class scout\",\n    \"enemy_knows\": \"The Reaver is defending its stolen loot.\",\n    \"aftershock\": \"You find the cargo and Kaelen offers a new contract.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"Ghost Signals in the Ore\",\n    \"signal\": \"Short bursts of data packets from deep space.\",\n    \"first_appearance\": \"Found within the encrypted files of a stolen haul.\",\n    \"escalation\": \"The signals become more frequent and structured as you move further out.\",\n    \"payoff_hint\": \"The data suggests a massive, automated manufacturing hub.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Shadow Market\",\n    \"trail_id\": \"rumor_trail.shadow_market\",\n    \"hint_theme\": \"Illegal trade and black market minerals.\",\n    \"clue_templates\": [\"A smuggler mentions a hidden dock.\", \"A scavenger reports finding high-grade ore.\"],\n    \"discovery_type\": \"hidden_discovery\",\n\"rarity\": \"uncommon\",\n    \"payoff\": \"Access to a secret trade hub with higher profit margins.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The gates lead to systems where the core is desperate.\",\n    \"new_system_reveal_rule\": \"New systems are revealed only when a gate is activated.\",\n    \"future_faction_tease\": \"Rumors of a group that values order over profit.\",\n    \"future_ore_or_upgrade_tease\": \"Experimental mining tools and heavy-duty hull plating.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regen_scarcity_hunt\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_arc\",\n      \"description\": \"When Act 1 is complete, add a new arc about the shadow market.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Use dry, gritty frontier humor.\",\n    \"fall_back_rule\": \"If a contract is failed, Kaelen gives you another one immediately.\",\n    \"banned_repeats\": [\"chosen one\", \"destiny\", \"prophecy\", \"signal\"]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What are the consequences of the core's manufacturing demand?\",\n    \"Why is the Vanguard a struggling patrol force?\",\n    \"How does Kaelen have access to information about illegal refining?\",\n    \"Who are the allies who still operate in the rested peace?\",\n    \"Which gate leads to the most stable trade routes?\"\n  ]\n}",
