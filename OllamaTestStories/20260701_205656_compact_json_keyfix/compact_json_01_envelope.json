  "model": "gemma4:12b",
  "created_at": "2026-07-02T00:57:29.1285747Z",
  "response": "{\"campaign_title\": \"Echoes of the Voided Gate\",\n  \"campaign_subtitle\": \"The Scavenger's Toll\",\n  \"campaign_logline\": \"A desperate pilot navigates a decaying trade route between three warring factions.\",\n  \"campaign_pitch\": \"You are a debt-ridden freelancer in a crumbling sector. Survive the skirmishes and find enough salvage to keep your ship flying.\",\n  \"campaign_story_summary\": \"The Zenith Corporation claims ownership of the primary gate. Aurelia seeks independence through blockade tactics. The Vanguard protects the trade routes from pirates. You must navigate their shifting alliances while scavenging for parts.\",\n  \"tone\": \"Dry, gritty frontier humor with a sense of industrial decay.\",\n  \"opening\": {\n    \"status_quo\": \"Trade routes are collapsing due to failing gate infrastructure.\",\n    \"visible_crisis\": \"Pirates and scavengers are raiding official shipments.\",\n    \"hidden_crisis\": \"The gates are losing power because the core stabilizers are being diverted elsewhere.\",\n    \"why_now\": \"A major shipment of stabilizer components has just vanished into the local sector.\",\n    \"player_role\": \"An independent pilot with a failing engine and mounting debts.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why is the gate infrastructure collapsing?\",\n    \"false_answer\": \"The infrastructure is decaying naturally due to age.\",\n    \"true_answer_hint\": \"A clandestine operation is siphoning power for a massive, unknown project.\",\n    \"long_term_reveal_direction\": \"The scope of the siphon is revealed through increasing gate instability.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker and contract handler.\",\n    \"secret_angle\": \"She knows about the power siphoning but remains silent.\",\n    \"address_rule\": \"Always refer to her as a broker or fixer.\",\n    \"never_reveal_rule\": \"Never reveal her true purpose or any knowledge of the gate's core.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith is struggling to maintain their monopoly on the trade routes.\",\n    \"aurelia__problem\": \"Aurelia is facing a shortage of essential mining materials.\",\n    \"vanguard_problem\": \"Vanguard is losing control over the security zones.\",\n    \"conflict_triangle\": \"The three factions are fighting over the remaining stable gate nodes.\",\n    \"neutral_space_pressure\": \"Pirates and scavengers thrive in the lawless gaps between faction territories.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Broken Circuit\",\n    \"goal\": \"Secure enough parts to repair a local jump-gate node.\",\n    \"opening_incident\": \"You find a derelict ship carrying high-value components and a pirate scavenger.\",\n    \"midpoint_turn\": \"Kaelen offers you a contract to secure the cargo from a rival faction's claim.\",\n    \"finale\": \"You successfully repair the node, but it triggers an alarm in a distant sector.\",\n    \"player_takeaway\": \"The local gate is now stable enough for your next jump.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"Scavenger's Toll\",\n    \"reason\": \"A pirate ship has intercepted your haul of scrap metal.\",\n    \"enemy_identity\": \"Reaver class scavenger vessel.\",\n    \"enemy_knows\": \"The pirate knows only that you have cargo.\",\n    \"aftershock\": \"You find a data-chip containing coordinates to a nearby derelict.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"Static Pulse\",\n    \"signal\": \"A rhythmic pulse of static every time you enter a gate.\",\n    \"first_appearance\": \"First heard during the starter mission's aftermath.\",\n    \"escalation\": \"The frequency increases as you get closer to the core.\",\n    \"payoff_hint\": \"The pulse is actually an automated warning from a failing system.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"Ghost of the Gate\",\n    \"trail_id\": \"rumor_trail.ghost_of_the_gate\",\n    \"hint_theme\": \"Reports of ships vanishing into the gate's core.\",\n    \"clue_templates\": [\n      \"A pilot reported a ship disappearing in the sector.\",\n      \"Rumors say the gate is unstable and dangerous.\"\n],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"local\",\n    \"rumor_trail_payoff\": \"You find a hidden cache of supplies and parts.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The next gate is heavily guarded by the Vanguard.\",\n    \"new_system_reveal_rule\": \"New systems are revealed only after a jump.\",\n    \"future_faction_tease\": \"Rumors of an unknown group seeking the gate's power.\",\n    \"future_ore_or_upgrade_tease\": \"Rare minerals found in the outer rim are highly sought by all factions.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regeneration_trigger.gate_stability\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_arc\",\n      \"description\": \"When the first act is completed, a new story arc is added.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Dry, slightly dark humor.\",\n    \"fallback_rule\": \"If no contract is available, Kaelen gives you a task involving salvage.\",\n    \"banned_repeats\": [\n      \"chosen one\",\n      \"destiny\",\n      \"prophecy\",\n      \"signal_of_siren\",\n      \"scavenger_toll_mission\"\n    ]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What is the source of the current gate power siphon?\",\n    \"Why are there still any ships in this sector?\",\n    \"How many factions involved in different secret agendas?\",\n    \"Who is the person behind the organization siphoning energy?\",\n    \"Where is the next stable jump point located?\"\n  ]\n}",
