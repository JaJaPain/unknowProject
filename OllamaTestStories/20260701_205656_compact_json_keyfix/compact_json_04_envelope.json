  "response": "{\"campaign_title\": \"Dust of the Rim\",\n  \"campaign_subtitle\": \"A Scavenger's Survival\",\n  \"campaign_logline\": \"A broke pilot must navigate the shifting trade routes between three warring factions.\",\n  \"campaign_pitch\": \"Navigate a dying economic zone. Survive the pirate raids and secure your own fuel supply.\",\n  \"campaign_story_summary\": \"The Zenith corporation faces resource shortages. The Aurelia Collective demands more territory. The Vanguard militia guards the border. You are just trying to survive.\",\n  \"tone\": \"Dry, gritty frontier humor.\",\n  \"opening\": {\n    \"status_quo\": \"Trade routes are failing due to heavy pirate activity.\",\n    \"visible_crisis\": \"The Zenith corporation is losing supply lines and desperate for resources.\",\n    \"hidden_crisis\": \"A massive industrial collapse in the core systems is forcing a migration of wealth.\",\n    \"why_now\": \"Fuel prices have spiked, making independent survival nearly impossible.\",\n    \"player_role\": \"An independent pilot with an aging ship and empty pockets.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why are the pirates so aggressive now?\",\n    \"false_answer\": \"They are just desperate scavengers looking for scraps.\",\n    \"true_answer_hint\": \"The pirate routes follow a specific, planned pattern of destruction.\",\n    \"long_term_reveal_direction\": \"A corporate conspiracy to create artificial scarcity.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker and fixer for independent pilots.\",\n    \"secret_angle\": \"She monitors the movement of cargo that shouldn't exist.\",\n    \"address_rule\": \"Always refer to her as a broker or fixer.\",\n    \"never_reveal_rule\": \"Never reveal her origin, true name, or any special abilities.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith is running out of refined fuel and needs new sources.\",\n    \"aurelia_problem\": \"Aurelia wants to expand their territory into the contested zones.\",\n    \"vanguard_problem\": \"The Vanguard are struggling to hold the line against pirate incursions.\",\n    \"conflict_triangle\": \"Zenith wants resources, Aurelia wants land, and Vanguard must defend it.\",\n    \"neutral_space_pressure\": \"Independent pilots are being squeezed out of the lucrative trade routes.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Scavenger's Path\",\n    \"goal\": \"Establish a foothold in the local sector.\",\n    \"opening_incident\": \"A cargo ship is intercepted by a pirate vessel.\",\n    \"midpoint_turn\": \"You find a shipment of high-grade minerals that both Zenith and Aurelia want.\",\n    \"finale\": \"You must choose which faction to deliver the materials to.\",\n    \"player_takeaway\": \"The local economy is fractured, and every choice has a cost.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"The Lone Raider\",\n    \"reason\": \"A pirate ship is harassing trade routes near your home port.\",\n    \"enemy_identity\": \"Reaver-class scavenger ship.\",\n    \"enemy_knows\": \"It thinks you are an easy target for scrap metal.\",\n    \"aftershock_reason\": \"The local authorities will notice the pirate's destruction.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"Ghost Signals\",\n    \"signal\": \"A rhythmic pulse of data packets on a 10hz frequency.\",\n    \"first_appearance\": \"Detected during your first mission to clear the path.\",\n    \"escalation\": \"The signal appears more frequently near high-value cargo.\",\n    \"payoff_hint\": \"The signals are linked to an automated mining network.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Ghost Mine\",\n    \"trail_id\": \"rumor_trail.ghost_mine_scavenge\",\n    \"hint_theme\": \"Whispers of a massive, abandoned mine.\",\n     \"clue_templates\": [\"A local trader mentions an old mining site.\", \"A derelict ship's log warns of heavy radiation.\"],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"rare\",\n    \"payoff\": \"Unlocks access to a high-value, hidden mineral zone.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The gate leads to a realm of uncharted territory and new resources.\",\n    \"new_system_reveal_rule\": \"New systems are revealed only when the player reaches the nearest gate.\",\n    \"future_faction_tease\": \"Rumors of a nomadic tribe that controls the trade routes.\",\n    \"future_ore_or_upgrade_tease\": \"There is talk of being able to find more advanced alloys.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regen_gate_trigger\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the main arc of Act 1 is complete, a new gate's path is teased.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Dry, slightly dark humor.\",\n    \"fallback_rule\": \"If no story content is available, use a generic trade mission.\",\n    \"banned_repeats\": [\"chosen one\", \"destiny\", \"scarcity\", \"pirate raids\"]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What are the pirate ships' names?\",\n    \"Why is the core system experiencing a collapse?\",\n    \"How many ships in the vanguard to be hired as mercs?\",\n    \"Who is behind the organization that tracks the rumors?\",\n    \"Where is the turn point for the next campaign?\"]\n  }",
