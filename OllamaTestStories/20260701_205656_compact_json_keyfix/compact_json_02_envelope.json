  "response": "{\"campaign_title\": \"The Hollowed Vein\",\n  \"campaign_subtitle\": \"Scarcity in the Rim\",\n  \"campaign_logline\": \"A struggling pilot navigates a dying trade route between three competing factions.\",\n  \"campaign_pitch\": \"Survival is the only currency on the edge of space. You must navigate the greed of Zenith, Aurelia, and Vanguard to keep your ship flying.\",\n  \"campaign_story_summary\": \"The local mining veins are drying up. Trade routes are becoming increasingly dangerous due to pirate activity. The three main factions are tightening their grip on resources. You start as a pilot trying to make a living. Every contract is a step toward staying afloat.\",\n  \"tone\": \"Dry, gritty frontier humor.\",\n  \"opening\": {\n    \"status_quo\": \"Trade routes between the core and rim are failing.\",\n    \"visible_crisis\": \"Pirates are raiding mining outposts and stealing cargo.\",\n    \"hidden_crisis\": \"The primary ore source is depleting at a rate that will collapse the economy.\",\n    \"why_now\": \"A major refinery hub has just been shut down by the central authority.\",\n    \"player_role\": \"An independent pilot seeking to pay off debts.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why is the local ore source disappearing so fast?\",\n    \"false_answer\": \"Pirates are stealing it for a black market trade.\",\n    \"true_answer_hint\": \"The extraction process itself is destabilizing the planetary crust.\",\n    \"long_term_reveal_direction\": \"The geological instability will eventually cause seismic shifts in the system's mining zones.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker and contract handler.\",\n    \"secret_angle\": \"She knows exactly how much time is left before the collapse.\",\n    \"address_rule\": \"Refer to her as a broker or fixer.\",\n    \"never_reveal_rule\": \"Never reveal her role as an observer of the system's decay.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"They are hoarding resources to maintain their luxury lifestyle.\",\n    \"aurelia_problem\": \"They are desperate for new sources and are expanding aggressively.\",\n    \"vanguard_problem\": \"They prioritize security but are causing heavy collateral damage.\",\n    \"conflict_triangle\": \"The three factions are fighting over the remaining high-grade ore veins.\",\n    \"neutral_space_pressure\": \"Pirates are filling the void left by official enforcement.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Drying Well\",\n    \"goal\": \"Secure a steady supply of trade routes and cargo.\",\n    \"opening_incident\": \"A shipment of high-core ore is intercepted by an unknown pirate ship.\",\n    \"midpoint_turn\": \"You discover that the Aurelia faction is sabotaging Zenith's mining equipment.\",\n    \"finale\": \"You must choose which faction to support during a trade route negotiation.\",\n    \"player_takeaway\": \"The scarcity of resources makes every contract more valuable.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"The Scavenger's Toll\",\n    \"reason\": \"A pirate ship is harassing the local mining lanes.\",\n    \"enemy_identity\": \"Reaver-class scout ship.\",\n    \"enemy_knows\": \"The vessel is a rogue scavenger seeking easy loot.\",\n    \"aftershock\": \"You find a small cache of refined ore in the debris.\"\n  },\n  \"recurring_lue\": {\n    \"name\": \"The Ghost Signal\",\n    \"signal\": \"A faint, rhythmic pulse from an abandoned mine.\",\n    \"first_appearance\": \"Detected during your first trip to the mining zone.\",\n    \"escalation\": \"The signal becomes more frequent as you move closer to the core.\",\n    \"payoff_hint\": \"It is a warning of the geological instability.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Shadow Market\",\n    \"trail_id\": \"rumor_trail.shadow_market\",\n    \"hint_theme\": \"Illegal trade and black market goods.\",\n    \"clue_templates\": [\"A merchant mentions a hidden port.\", \"A smuggler warns of the shadow market.\"],\n    \"discovery_type\": \"hidden__discovery\",\n    \"rarity\": \"uncommon\",\n    \"payoff\": \"Access to high-grade cargo and rare upgrades.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The gates lead to systems where the ore is still plentiful.\",\n    \"new_system_reveal_rule\": \"New systems are revealed only as you approach a gate.\",\n    \"future_faction_tease\": \"Rumors of a fourth, more aggressive faction emerging in the distance.\",\n    \"future_ore_or_upgrade_tease\": \"The rumor of a legendary ore type that can power advanced engines.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regen_system_scarcity\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the first act ends, a new set of rumors and gates are added.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Dry, slightly dark humor.\",\n    \"fallback_rule\": \"If no contract is available, offer a cargo haul for fuel.\",\n    \"banned_repeats\": [\"chosen one\", \"destiny\", \"prophecy\", \"ancient signal\"]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What happens if the player chooses to support Aurelia?\",\n    \"Why is the Ghost Signal becoming more frequent?\",\n    \"How does the Vanguard deal with pirate activity in their sector?\",\n    \"Who are the hidden players behind the core resource collapse?\",\n    \"Where do the gates lead and what are they actually protecting?\"\n  ]\n}",
