  "model": "gemma4:12b",
  "created_at": "2026-07-02T01:03:29.2926538Z",
  "response": "{\"campaign_title\": \"Dust of the Belt\",\n  \"campaign_subtitle\": \"The Scarcity Chronicles\",\n  \"campaign_logline\": \"A pilot's debt is paid in scrap and cargo.\",\n  \"campaign_pitch\": \"Debt collectors are closing in on the outer rim. You must secure trade routes for survival. Profit from the mines to stay ahead of the creditors.\",\n  \"campaign_story_summary\": \"The Zenith Corporation owns the primary ore veins. Aurelia seeks independence through independent mining claims. The Vanguard protects the shipping lanes against pirate raids. A shortage of refined minerals causes prices to skyrocket. You navigate these tensions to clear your debts. Every shipment delivered is a step toward freedom.\",\n  \"tone\": \"Dry, cynical frontier humor.\",\n  \"opening\": {\n    \"status_quo\": \"Mining colonies are struggling with high fuel costs.\",\n    \"visible_crisis\": \"A shortage of refined minerals has crippled trade routes.\",\n    \"hidden_crisis\": \"The Zenith Corporation is hoarding supplies to manipulate market prices.\",\n    \"why_now\": \"Your debt collectors have issued a final notice.\",\n    \"player_role\": \"An independent pilot with an overdue bill.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why are the mineral markets so unstable?\",\n    \"false_answer\": \"Pirate raids are destroying the transport ships.\",\n    \"true_answer_hint\": \"The Zenith Corporation is intentionally sabotaging their own supply lines to create a monopoly.\",\n    \"long_term_reveal_direction\": \"A shadow organization plans to control all trade by controlling the scarcity.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker and contract handler.\",\n    \"secret_angle\": \"She knows exactly who is manipulating the market.\",\n    \"address_rule\": \"Refer to her as a broker or fixer.\",\n    \"never_reveal_rule\": \"Never mention her role in any official capacity.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"They are monopolizing ore veins and creating artificial shortages.\",\n    \"aurelia_problem\": \"They want to break the monopoly but lack the resources to do so alone.\",\n    \"aurelia_problem_2\": \"They struggle with logistics and pirate activity in their zones.\",\n    \"conflict_triangle\": \"Zenith wants control, Aurelia wants freedom, Vanguard protects the lanes.\",\n    \"neutral_space_pressure\": \"Pirates and scavengers are moving into the empty gaps.\"\n  },\n  \"act_1\": {\n    \"name\": \"The First Shipment\",\n    \"goal\": \"Deliver a haul of refined minerals to a nearby station.\",\n    \"opening_incident\": \"A pirate ship is intercepted by your sensors during a delivery.\",\n    \"midpoint_turn\": \"You discover that the shipment you are carrying is actually stolen from a Zenith site.\",\n    \"finale\": \"You successfully deliver the cargo and receive a payment for your debts.\",\n    \"player_takeaway\": \"The market is more complex than it seems.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"Clear the Path\",\n    \"reason\": \"A pirate ship has blocked the main trade route.\",\n    \"enemy_identity\": \"Reaver-class scout ship.\",\n    \"enemy_knows\": \"The enemy is unaware of your presence until you engage.\",\n    \"after_effect\": \"You clear the path and receive a small reward for it.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"Marked Cargo\",\n    \"signal\": \"A recurring symbol on stolen Zenith crates.\",\n    \"first_appearance\": \"Found during your first delivery mission.\",\n    \"escalation\": \"The number of marked crates appears to increase over time.\",\n    \"payoff_hint\": \"These marks indicate a coordinated effort to move goods outside the law.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"Shadow Trade\",\n    \"trail_id\": \"rumor_trail.shadow_trade\",\n    \"hint_theme\": \"Illegal trade routes and hidden markets.\",\n    \"clue_templates\": [\"The market is flooded with cheap, high-quality ore.\", \"There are rumors of a secret tunnel in the belt.\"],\n    \"discovery_type\": \"hidden_delivery_route\",\n    \"rarity\": \"rare\",\n    \"payoff\": \"A hidden trade route that provides higher rewards for delivery.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The gates lead to systems with even more desperate resources.\",\n    \"new_system_reveal_rule\": \"Do not mention any other factions or specific names of new systems.\",\n    \"future_pressure_tease\": \"The demand for lure-based tactics and more complex trade routes is growing.\",\n    \"future_ore_or_upgrade_tease\": \"Better ships will allow you to deliver more cargo and earn more profit.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regeneration_trigger.scarcity_cycle\",\n       \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When a major arc is completed, new trade routes and hazards are added.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Use dry, cynical humor about the fuel costs and debt.\",\n    \"fallback\": \"If no quest is available, offer a contract for basic cargo delivery.\",\n    \"banned_repeats\": [\"chosen one\", \"destiny\", \"scarcity_crisis\"]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What are the reasons for the competition between Zenith and Aurelia?\",\n    \"Why is there a marked cargo symbol on stolen crates?\",\n    \"How do the markets be manipulated by a single corporation?\",\n    \"Who are the people behind the shadow trade routes?\",\n    \"Where can you find more refined minerals in the outlands?\"\n  ]\n}",
