  "response": "{\"campaign_title\": \"Wreckage of the Gilded Age\",\n  \"campaign_subtitle\": \"Scavenging the Dead Zones\",\n  \"campaign_logline\": \"A broke pilot navigates a decaying economic zone where salvage rights are the only currency.\",\n  \"campaign_pitch\": \"The Zenith Corporation owns the mineral rights. Aurelia seeks to reclaim lost trade routes. The Vanguard protects the local mining colonies.\",\n  \"campaign_story_summary\": \"Trade routes have collapsed into debris fields. Corporations and militias now fight over salvaged scrap. You are a pilot seeking profit in the ruins. Kaelen offers contracts for high-risk salvage jobs. Each haul brings you closer to a contested zone. The void is silent but the market is hungry.\",\n  \"tone\": \"Dry, cynical frontier humor.\",\n  \"opening\": {\n    \"status_quo\": \"Mining zones are depleted and heavily guarded by private security.\",\n    \"visible_crisis\": \"Supply chains for essential minerals are failing in the sector.\",\n    \"hidden_crisis\": \"A shortage of heavy industrial components is crippling local manufacturing.\",\n    \"why_now\": \"The central trade hub has declared a state of emergency.\",\n    \"player_role\": \"An independent pilot with an aging ship and empty pockets.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why are the salvage rights so heavily contested?\",\n    \"false_answer\": \"A rumor says the ships were destroyed by pirates.\",\n    \"true_answer_hint\": \"The mining corporations secretly hoarded materials for a private project.\",\n    \"long_term_reveal_direction\": \"The hoarding is part of an industrial infrastructure plan.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker, fixer, and contract handler.\",\n    \"secret_angle\": \"She knows the location of the hidden manufacturing hubs.\",\n    \"address_rule\": \"Address her as a broker or contractor.\",\n    \"never_reveal_rule\": \"Never reveal her role in the logistics network.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith wants to monopolize the remaining high-grade ore.\",\n    \"aurelia_problem\": \"Aurelia seeks to secure trade routes for their merchant fleet.\",\n    \"vanguard_problem\": \"Vanguard is struggling to maintain order in lawless zones.\",\n    \"conflict_triangle\": \"Zenith and Aurelia fight over the same scrap heaps.\",\n    \"neutral_space_pressure\": \"Pirates and scavengers are encroaching on the contested zones.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Scavenger's Path\",\n    \"goal\": \"Secure enough salvage to establish a stable route.\",\n    \"opening_incident\": \"You find a ship with an intact manifest of high-value cargo.\",\n    \"midpoint_turn\": \"A Vanguard patrol finds you and demands your haul.\",\n    \"finale\": \"You successfully deliver the scrap to a neutral station.\",\n    \"player_takeaway\": \"The market for salvage is lucrative but dangerous.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"Clear the Path\",\n    \"reason\": \"A local scavenger group needs you to clear out a rogue drone-ship.\",\n    \"enemy_identity\": \"Reaver ship\",\n    \"enemy_knows\": \"The Reaver is patrolling its designated sector.\",\n    \"after_effect\": \"You earn your first payout and a new cargo manifest.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"Ghost Manifests\",\n    \"signal\": \"A recurring pattern in the scrap metadata.\",\n    \"first_appearance\": \"Found on a high-value salvage haul.\",\n    \"escalation\": \"More manifests appear as you explore deeper.\",\n    \"payoff_hint\": \"The manifest lists items for a construction project.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Iron Mine\",\n    \"trail_id\": \"rumor_trail.iron_mine_scavenge\",\n    \"hint_theme\": \"Old mining equipment and heavy machinery.\",\n    \"clue_templates\": [\n      \"A rumor of a massive mine buried under debris.\",\n      \"A whisper of a hidden refinery in the sector.\"\n    ],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"rare\",\n    \"payoff\": \"Access to a high-value industrial zone.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"The next gate leads to a deeper mining district.\",\n    \"new_system_reveal_rule\": \"Do not reveal future factions or names of other systems.\",\n    \"future_pressure_tease\": \"A rumor of larger conflicts over industrial zones.\",\n    \"future_ore_or_upgrade_tease\": \"The promise of more complex machinery and tools.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regeneration.scavenge_path\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the first act ends, a new scavenger path is granted.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Use dry, cynical frontier humor.\",\n    \"fallback\": \"If no content is available, use a default salvage contract.\",\n    \"banned_repeats\": [\n      \"chosen one\",\n      \"destiny\",\n      \"ancient signal\",\n      \"ghost signal\",\n      \"mysterious pulse\"\n    ]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What are the reasons for the current salvage crisis?\",\n    \"Why do the factions involved in player's haul be more aggressive?\",\n    \"How many of other systems have been abandoned by corporations?\",\n    \"Who is the primary owner of the rest of the high-value scrap?\",\n    \"Where is the next collection point for the security forces?\"\n  ]\n}",
