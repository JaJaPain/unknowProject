  "response": "{\"campaign_title\": \"Fractured Orbit\",\n  \"campaign_subtitle\": \"The Scarcity of Sovereignty\",\n  \"campaign_logline\": \"A desperate pilot navigates the tense trade routes between three competing corporate empires.\",\n  \"campaign_pitch\": \"Scavenge resources from derelicts. Navigate political tensions between Zenith, Aurelia, and Vanguard. Survive the lawless frontier.\",\n  \"campaign_story_summary\": \"The sector is divided into three spheres of influence. Zenith demands strict compliance with trade routes. Aurelia seeks to expand their mining claims. Vanguard enforces a hardline stance on border security. You are an independent pilot seeking profit. A shortage of refined minerals has sparked a local conflict. You must navigate the friction between these powers.\",\n  \"tone\": \"Dry, cynical frontier humor.\",\n  \"opening\": {\n    \"status_quo\": \"The sector is divided among three corporate entities.\",\n    \"visible_crisis\": \"Refined mineral shortages are causing supply chain disruptions.\",\n    \"hidden_crisis\": \"A secret trade agreement between Zenith and Aurelia is failing.\",\n    \"why_now\": \"The collapse of the deal makes current routes dangerous.\",\n    \"player_role\": \"An independent pilot with a debt-ridden ship.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why are the mineral prices fluctuating so wildly?\",\n    \"false_answer\": \"A pirate group is sabotaging the supply lines.\",\n    \"true_answer_hint\": \"The minerals are being diverted to an off-world project.\",\n    \"long_term_reveal_direction\": \"The diversion reveals a secret infrastructure project.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker and contract handler.\",\n    \"secret_angle\": \"She knows the true destination of the diverted minerals.\",\n    \"address_rule\": \"Refer to her as a broker or fixer.\",\n    \"never_reveal_rule\": \"Never reveal her role in the shadow government.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zen_policy_enforcement\",\n    \"aurelia_problem\": \"Aurelia_mining_expansion\",\n    \"vanguard_problem_us_hardline_security\": \"Vanguard_border_security\",\n    \"conflict_triangle\": \"The three factions are fighting over the overlap of mining claims.\",\n    \"neutral_space_pressure\": \"Pirates and scavengers populate the lawless zones.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Broker's Contract\",\n    \"goal\": \"Secure a stable supply route for Aurelia.\",\n    \"opening_incident\": \"A shipment of refined minerals is intercepted by Vanguard patrols.\",\n    \"midpoint_turn\": \"You discover that the cargo was meant for Zenith territory.\",\n    \"finale\": \"You successfully deliver the cargo to an Aurelia outpost.\",\n    \"player_takeaway\": \"The player learns that logistics are a weapon.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"Clear the Path\",\n    \"reason\": \"A pirate ship is blocking a primary trade route.\",\n    \"enemy_identity\": \"Reaver-class interceptor\",\n    \"enemy_knows\": \"The Reaver is patrolling its assigned sector.\",\n    \"after_effect\": \"You earn your first payment and local reputation.\"\n  },\n  \"recurring_clue\": {\n    \"name\": \"Marked Cargo\",\n     \"signal\": \"A recurring pattern of marked crates in non-standard ports.\",\n    \"first_appearance\": \"The player finds a crate with an Aurelia logo.\",\n    \"escalation\": \"More shipments appear in locations that are restricted zones.\",\n    \"payoff_hint\": \"These crates contain high-grade components for specialized construction.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Ghost Route\",\n    \"trail_id\": \"rumor_trail.ghost_route\",\n    \"hint_theme\": \"Smuggled goods and hidden passages.\",\n    \"clue_templates\": [\n      \"A smuggler claims a route exists outside of official records.\",\n      \"A merchant says the cargo is moving in the opposite direction.\"\n    ],\n    \"discovery_type\": \"secret_route\",\n    \"rarity\": \"uncommon\",\n    \"payoff\": \"Unlock a hidden passage to a nearby mining colony.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"A gate is rumored to be unstable and leads to unknown territory.\",\n    \"new_system_reveal_rule\": \"Introduce new systems based on the player's choice of faction support.\",\n    \"future__pressure_tease\": \"Rumors of a growing pirate presence in the outer rim.\",\n    \"future_ore_or_upgrade_tease\": \"A rare ore type is found only in the system's edge.\",\n    \"regeneration_trigger\": {\n      \"id\": \"regen_broker_contract\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_arc\",\n      \"description\": \"When a major arc is completed, add a new contract for the next system.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Use dry humor. Avoid jokes about space-time.\",\n    \"fallback\": \"If no contract is available, offer a delivery mission.\",\n    \"banned_repeats\": [\n      \"chosen one\",\n      \"destiny\",\n      \"ghost signal\",\n      \"mystery_pulse\"\n    ]\n    }\n  }",
