  "response": "{\"campaign_title\": \"The Scarcity Protocol\",\n  \"campaign_subtitle\": \"Trade Routes of the Broken Rim\",\n  \"campaign_logline\": \"A desperate pilot navigates a web of forged contracts and corporate sabotage.\",\n  \"campaign_pitch\": \"You are a debt-ridden freighter. You must navigate competing interests in the outer rim. Survival depends on finding legitimate routes.\",\n  \"campaign_story_summary\": \"The Zenith Corporation owns the primary trade gates. Aurelia seeks to bypass their tolls. The Vanguard militia secures the contested border zones. A shortage of refined minerals causes high tensions. Smuggling becomes a lucrative but dangerous necessity. You are hired by Kaelen to move illicit cargo.\",\n  \"tone\": \"Dry, cynical frontier humor.\",\n  \"opening\": {\n    \"status_quo\": \"The Rim is a lawless trade hub.\",\n    \"visible_crisis\": \"Trade routes are collapsing due to heavy tariffs.\",\n    \"hidden_crisis\": \"A shortage of refined minerals is causing supply chain collapse.\",\n    \"why_now\": \"Kaelen offers high-paying contracts for 'special' cargo.\",\n    \"player_role\": \"A debt-ridden independent pilot.\"\n  },\n  \"mystery\": {\n    \"question\": \"Why are the trade gates failing?\",\n    \"false_answer\": \"The gates are suffering from mechanical decay.\",\n    \"true_answer_hint\": \"The gate infrastructure is being intentionally sabotaged by a third party.\",\n    \"long_term_reveal_direction\": \"A shadow organization is dismantling the network to monopolize transit.\"\n  },\n  \"kaelen\": {\n    \"public_role\": \"Broker, fixer, and contract handler.\",\n    \"secret_angle\": \"She knows which factions are actively sabotaging the gates.\",\n    \"address_rule\": \"Refer to her as a broker or contractor.\",\n    \"never_reveal_rule\": \"Her origins and true motives remain unknown.\"\n  },\n  \"factions\": {\n    \"zenith_problem\": \"Zenith is struggling to maintain gate integrity against pirates.\",\n    \"aurelia_problem\": \"Aurelia seeks independent routes outside Zenith control.\",\n    \"vanguard_problem\": \"Vanguard patrols are becoming increasingly aggressive and restrictive.\",\n    \"conflict_triangle\": \"The three factions fight over the remaining stable gates.\",\n    \"neutral_space_pressure\": \"Pirates and scavengers haunt the unregulated zones.\"\n  },\n  \"act_1\": {\n    \"name\": \"The Black Market Loop\",\n    \"goal\": \"Deliver a shipment of refined minerals to an Aurelian outpost.\",\n    \"opening_incident\": \"Kaelen gives you a contract for 'medical supplies'.\",\n    \"midpoint_turn\": \"You are intercepted by a Zenith patrol ship.\",\n    \"finale\": \"You successfully deliver the cargo and receive a payout.\",\n    \"player_takeaway\": \"The market is flooded with forged contracts.\"\n  },\n  \"starter_mission\": {\n    \"title\": \"The Ghost Cargo\",\n    \"reason\": \"Kaelen needs you to move supplies past a patrol.\",\n    \"enemy_identity\": \"A lone Reaver scout ship.\",\n    \"enemy_knows\": \"The Reaver is patrolling the sector for illegal trade.\",\n    \"after_effect\": \"You receive payment and Kaelen's next lead.\"\n  },\n  \"recurring_clue\": {\n    \"10-year-old-scout_id\": \"Scout Logs\",\n    \"signal\": \"A faint signal from a derelict scout ship.\",\n    \"first_appearance\": \"Found near the first delivery point.\",\n    \"escalation\": \"The logs mention a specific gate failure.\",\n    \"payoff_hint\": \"The logs lead to a location of interest.\"\n  },\n  \"rumor_trail\": {\n    \"name\": \"The Shadow Network\",\n    \"trail_id\": \"rumor_trail.shadow_network\",\n    \"hint_theme\": \"Smuggling routes and hidden paths.\",\n    \"clue_templates\": [\"A whisper of a secret route.\", \"A rumor of forged documents.\"],\n    \"discovery_type\": \"hidden_discovery\",\n    \"rarity\": \"uncommon\",\n    \"payoff\": \"Unlocks a hidden passage in the sector.\"\n  },\n  \"horizon\": {\n    \"gate_tease\": \"Rumors of gates that do not appear on maps.\",\n    \"new_system_reveal_rule\": \"Do not mention other factions or specific names.\",\n    \"future_pressure_tease\": \"The tension between the forces is growing.\",\n    \"future_ore_or_upgrade_tease\": \"Rare minerals are needed for ship upgrades.\",\n    \"regeneration_trigger\": {\n      \"id\": \"gate_passage_trigger\",\n      \"metric\": \"major_arc_state\",\n      \"threshold\": 0,\n      \"action\": \"append_story_horizon\",\n      \"description\": \"When the main arc ends, a new gate is revealed.\"\n    }\n  },\n  \"rules\": {\n    \"humor_rule\": \"Use dry, cynical frontier humor.\",\n    \"fallback\": \"If no clue is found, Kaelen gives you another contract.\",\n    \"banned_repeats\": [\"chosen one\", \"destiny\", \"ghost signal\", \"echoes of the void\", \"mysterious pulse\"]\n  },\n  \"story_questions_for_future_generation\": [\n    \"What are the consequences of choosing a side?\",\n    \"Why is the gate infrastructure being sabotaged?\",\n    \"How do they find the other smuggling routes?\",\n    \"Who is behind the rumors of shadow networks?\",\n    \"Where is the next stable gate located?\"\n  ]\n}",
