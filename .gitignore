# Godot-specific ignores
.godot/

# Large editor executables
Godot/

# OS-specific files
.DS_Store
Thumbs.db

# Audio files
*.mp3
*.wav
*.ogg
*.mp3.import
*.wav.import
*.ogg.import

# 3D Models and meshes
*.glb
*.gltf
*.obj
*.fbx
*.dae
*.glb.import
*.gltf.import
*.obj.import
*.fbx.import
*.dae.import

# Textures extracted locally when Godot imports the external hypergate GLB.
assets/hypergate_*

# Large faction ship model packages and their local texture sets.
Ships/Aurlelia/
Ships/Vanguard/
Ships/Zenith/
Ships/.deprecated/

# Generated ship assets (regenerated by ShipPreGenerator at runtime)
assets/ships/generated/

# Python bytecode
__pycache__/
*.pyc

# Local bug investigation screenshots (not for the repo)
docs/bug_screenshots/

# Local Godot test logs (Claude headless runs)
.tmp_godot_user/

# Permanent fallback diagnostics log (runtime data; persists on disk, out of git)
logs/

# Local scratch / quarantine (stray files kept off the repo)
_local/

# Kitbash ship part library — committed as runtime source of truth for ShipAssembler
!assets/ship_parts/**/*.glb

# Local Antigravity ship-part experiments
assets/TestShips/
assets/ship_parts/**/*AMT.glb
assets/ship_parts/**/*_variant.blend
assets/ship_parts/**/*_variant.blend.import
assets/ship_parts/**/*_variant.blend1
docs/ship_previews/thrusters/
docs/ship_previews/*.png.import
tools/assembler_preview/*.gd.uid
tools/assembler_preview/inspect_engine_part.gd
tools/assembler_preview/thruster_preview.gd
tools/assembler_preview/thruster_preview.tscn

# Local lounge-review environment and runtime checkpoints
tools/lounge_review/.venv/
tools/lounge_review/*_generation.log
tools/lounge_review/*_generation_errors.log
tools/lounge_review/generator_*.log
